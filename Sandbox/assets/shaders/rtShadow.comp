#version 460

#extension GL_EXT_ray_query : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, r16f) uniform writeonly image2D outputMask;
layout(set = 0, binding = 1) uniform sampler2D gBufferPos;     // world space
layout(set = 0, binding = 2) uniform sampler2D gBufferNorm;    // world space, cleared to 0 where nothing was drawn
layout(set = 0, binding = 3) uniform accelerationStructureEXT topLevelAS;

layout(push_constant) uniform Params {
    vec4 sunDirection;      // toward the sun
    float coneAngle;        // radians, half the sun's angular size
    int rayCount;
    float maxDistance;
} pc;

const float TWO_PI = 6.28318531;

uint hash(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float random(inout uint state) {
    state = hash(state);
    return float(state) / 4294967295.0;
}

// uniform direction inside a cone around the sun direction, the spread is what softens the shadow
vec3 sampleCone(vec3 axis, float cosMax, float u1, float u2) {
    float cosTheta = mix(1.0, cosMax, u1);
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));
    float phi = TWO_PI * u2;
    vec3 T = normalize(abs(axis.y) < 0.999 ? cross(axis, vec3(0.0, 1.0, 0.0)) : cross(axis, vec3(1.0, 0.0, 0.0)));
    vec3 B = cross(axis, T);
    return normalize(T * (sinTheta * cos(phi)) + B * (sinTheta * sin(phi)) + axis * cosTheta);
}

// 1 lit, 0 fully blocked from the sun
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputMask);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    vec4 position = texelFetch(gBufferPos, pixel, 0);
    vec3 N = texelFetch(gBufferNorm, pixel, 0).xyz;
    vec3 L = normalize(pc.sunDirection.xyz);
    if (dot(N, N) < 0.01) {
        imageStore(outputMask, pixel, vec4(1.0));
        return;
    }

    // facing away from the sun is already dark from the brdf, no ray needed
    N = normalize(N);
    if (dot(N, L) <= 0.0) {
        imageStore(outputMask, pixel, vec4(0.0));
        return;
    }

    vec3 origin = position.xyz + N * 0.02;
    float cosMax = cos(pc.coneAngle);
    int rays = pc.coneAngle > 0.0 ? max(pc.rayCount, 1) : 1;

    uint seed = hash(uint(pixel.x) * 1973u + uint(pixel.y) * 9277u);
    float lit = 0.0;
    for (int i = 0; i < rays; i++) {
        vec3 dir = pc.coneAngle > 0.0 ? sampleCone(L, cosMax, random(seed), random(seed)) : L;

        rayQueryEXT rayQuery;
        rayQueryInitializeEXT(rayQuery, topLevelAS, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xFF, origin, 0.001, dir, pc.maxDistance);
        while (rayQueryProceedEXT(rayQuery)) {}

        if (rayQueryGetIntersectionTypeEXT(rayQuery, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
            lit += 1.0;
        }
    }

    imageStore(outputMask, pixel, vec4(lit / float(rays)));
}
