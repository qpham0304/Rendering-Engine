#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraData {
    mat4 projection;
    mat4 view;
    mat4 invProj;
    mat4 invView;
} camera;

layout(set = 0, binding = 1, rgba16f) writeonly uniform image2D outImage;
layout(set = 0, binding = 2) uniform sampler2D giImage; 
layout(set = 0, binding = 3) uniform sampler2D sceneImage; 
layout(set = 0, binding = 4) uniform sampler2D albedoImage; 
layout(set = 0, binding = 5) uniform sampler2D bloomImage; 
layout(set = 0, binding = 6) uniform sampler2D lastFrameIrradianceAtlas; 
layout(set = 0, binding = 7) uniform sampler2D depthImage;
layout(set = 0, binding = 8) uniform sampler2D normalImage;
layout(set = 0, binding = 9) uniform sampler2D lastFrameVisibilityAtlas;

layout(push_constant) uniform Constants {
    vec2 screenRes;
    float time;
    float frameSeed;
    int shouldCombine;
    float gridSpacing;
    uint probesPerDimension;
    vec4 gridOrigin;
    uint probesResolution;
} pc;

vec3 getPosWorld(vec2 uv, float depth) {
    vec4 clip = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 viewPos = camera.invProj * clip;
    viewPos /= viewPos.w;
    vec4 worldPos = camera.invView * viewPos;
    return worldPos.xyz;
}

#define PI 3.14159265359

vec2 octEncode(vec3 v) {
    float l1norm = abs(v.x) + abs(v.y) + abs(v.z);
    vec2 result = v.xy * (1.0 / (l1norm > 0.0 ? l1norm : 1.0));
    if (v.z < 0.0) {
        vec2 signNotZero = vec2(result.x >= 0.0 ? 1.0 : -1.0, result.y >= 0.0 ? 1.0 : -1.0);
        result = (1.0 - abs(result.yx)) * signNotZero;
    }
    return result;
}

vec2 getAtlasUV(uint probeIdx, vec3 texturingDirection, uint stride, uint coreRes, vec2 totalAtlasSize) {
    vec2 octCoord = octEncode(normalize(texturingDirection));
    vec2 localUV = octCoord * 0.5 + 0.5;
    vec2 pixelCoordInTile = localUV * float(coreRes);
    uint tilesX = pc.probesPerDimension;
    ivec2 tileCoord = ivec2(probeIdx % tilesX, probeIdx / tilesX);
    vec2 finalPixelCoord = (vec2(tileCoord) * float(stride)) + vec2(1.0) + pixelCoordInTile;
    return finalPixelCoord / totalAtlasSize;
}

vec3 sampleDDGIIrradiance(vec3 worldPos, vec3 worldNormal) {
    // Normal bias shifts sample out of geometric surfaces cleanly
    vec3 biasedWorldPos = worldPos + worldNormal * 0.12;
    vec3 gridSpacePos = (biasedWorldPos - pc.gridOrigin.xyz) / pc.gridSpacing;
    
    if (any(lessThan(gridSpacePos, vec3(0.0))) || any(greaterThan(gridSpacePos, vec3(float(pc.probesPerDimension - 1))))) {
        return vec3(0.0);
    }
    
    ivec3 baseProbeXYZ = ivec3(floor(gridSpacePos));
    vec3 trilinearWeights = fract(gridSpacePos); 
    
    vec3 accumulatedIrradiance = vec3(0.0);
    float totalWeight = 0.0;
    
    uint totalProbes = pc.probesPerDimension * pc.probesPerDimension * pc.probesPerDimension;
    uint tilesX = pc.probesPerDimension;
    uint tilesY = (totalProbes + tilesX - 1) / tilesX;
    vec2 irrAtlasSize = vec2(tilesX * 10, tilesY * 10);
    vec2 visAtlasSize = vec2(tilesX * 18, tilesY * 18);
    
    for (int i = 0; i < 8; ++i) {
        ivec3 offset = ivec3(i & 1, (i >> 1) & 1, (i >> 2) & 1);
        ivec3 probeXYZ = clamp(baseProbeXYZ + offset, ivec3(0), ivec3(int(pc.probesPerDimension - 1)));
        
        uint probeIdx = uint(probeXYZ.x + (probeXYZ.z * int(pc.probesPerDimension)) + (probeXYZ.y * int(pc.probesPerDimension * pc.probesPerDimension)));
        
        vec3 spatialWeights = mix(1.0 - trilinearWeights, trilinearWeights, vec3(offset));
        float triWeight = spatialWeights.x * spatialWeights.y * spatialWeights.z;
        
        vec3 probePos = pc.gridOrigin.xyz + vec3(probeXYZ) * pc.gridSpacing;
        vec3 probeToPoint = biasedWorldPos - probePos;
        float distanceToProbe = length(probeToPoint);
        if (distanceToProbe < 0.0001) continue;
        
        vec3 directionToProbe = probeToPoint / distanceToProbe;
        
        // Pure geometric components (Sum up precisely to 1.0 across the 8-cell bounds)
        float cosineWeight = max(0.0, dot(-directionToProbe, worldNormal));
        float geometricWeight = triWeight * (cosineWeight + 0.001);
        
        // Visibility Occlusion: Used exclusively as a direct radiance scale multiplier, 
        // preventing near-zero division blowouts.
        vec2 visUV = getAtlasUV(probeIdx, directionToProbe, 18, 16, visAtlasSize);
        vec2 visibilityData = texture(lastFrameVisibilityAtlas, visUV).rg;
        
        float mean = visibilityData.x;
        float variance = max(0.0001, visibilityData.y - (mean * mean));
        
        float chebyshevWeight = 1.0;
        if (distanceToProbe > mean) {
            float d = distanceToProbe - mean;
            chebyshevWeight = variance / (variance + d * d);
            chebyshevWeight = pow(max(0.0, chebyshevWeight), 6.0); 
        }
        
        // Anti-flicker proximity blend
        float proximityFade = smoothstep(0.005, 0.05, abs(distanceToProbe - mean));
        chebyshevWeight = mix(1.0, chebyshevWeight, proximityFade);
        
        if (geometricWeight > 0.0001) {
            vec2 irrUV = getAtlasUV(probeIdx, worldNormal, 10, 8, irrAtlasSize);
            vec3 irradianceSample = texture(lastFrameIrradianceAtlas, irrUV).rgb;
            
            // Multiply light intensity by chebyshevWeight *outside* the geometric divisor logic
            accumulatedIrradiance += (irradianceSample * max(0.002, chebyshevWeight)) * geometricWeight;
            totalWeight += geometricWeight;
        }
    }
    
    if (totalWeight < 0.0001) return vec3(0.0);
    return (accumulatedIrradiance / totalWeight) * PI;
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 screenRes = imageSize(outImage);
    if (pixelCoord.x >= screenRes.x || pixelCoord.y >= screenRes.y) return;

    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(screenRes);

    float depth = texture(depthImage, uv).r;
    vec3 albedo = texture(albedoImage, uv).rgb;
    vec3 normal = normalize(texture(normalImage, uv).rgb * 2.0 - 1.0); 
    vec3 fragPos = getPosWorld(uv, depth);

    vec3 indirectLight = sampleDDGIIrradiance(fragPos, normal);
    
    vec3 finalOut = (indirectLight * albedo);
    imageStore(outImage, pixelCoord, vec4(finalOut, 1.0));
}