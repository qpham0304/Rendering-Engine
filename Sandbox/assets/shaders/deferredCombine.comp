#version 460

#extension GL_GOOGLE_include_directive : require

#include "common/ddgi.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraData {
    mat4 projection;
    mat4 view;
    mat4 invProj;
    mat4 invView;
} camera;

layout(set = 0, binding = 1, rgba16f) writeonly uniform image2D outImage;
layout(set = 0, binding = 2) uniform sampler2D giImage;
layout(set = 0, binding = 3) uniform sampler2D sceneImage;
layout(set = 0, binding = 4) uniform sampler2D albedoImage;
layout(set = 0, binding = 5) uniform sampler2D bloomImage;
layout(set = 0, binding = 6) uniform sampler2D lastFrameIrradianceAtlas;
layout(set = 0, binding = 7) uniform sampler2D positionImage;
layout(set = 0, binding = 8) uniform sampler2D normalImage;
layout(set = 0, binding = 9) uniform sampler2D lastFrameVisibilityAtlas;
layout(set = 0, binding = 10) uniform sampler2D pbrImage;
layout(set = 0, binding = 11) readonly buffer SHData {
    vec4 shCoeffs[9];
} sh;

// same SH the light pass uses for its diffuse ibl, already carries the 1 / PI
vec3 getSkyIrradiance(vec3 N) {
    return max(vec3(0.0),
        0.886227 * sh.shCoeffs[0].xyz +
        1.023328 * sh.shCoeffs[1].xyz * N.y +
        1.023328 * sh.shCoeffs[2].xyz * N.z +
        1.023328 * sh.shCoeffs[3].xyz * N.x +
        0.858086 * sh.shCoeffs[4].xyz * N.x * N.y +
        0.858086 * sh.shCoeffs[5].xyz * N.y * N.z +
        0.247708 * sh.shCoeffs[6].xyz * (3.0 * N.z * N.z - 1.0) +
        0.858086 * sh.shCoeffs[7].xyz * N.x * N.z +
        0.429043 * sh.shCoeffs[8].xyz * (N.x * N.x - N.y * N.y)
    );
}

layout(push_constant) uniform Constants {
    vec2 screenRes;
    float time;
    float frameSeed;
    int shouldCombine;
    float gridSpacing;
    uint probesPerDimension;
    vec4 gridOrigin;
    uint probesResolution;
    float normalBias;
    float ddgiIntensity;
    int ddgiMode;           // 0: off, 1: on, 2: show the ddgi term only
    ivec4 probeCounts;      // xyz: probes per axis
    float skyIntensity;
} pc;

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 screenRes = imageSize(outImage);
    if (pixelCoord.x >= screenRes.x || pixelCoord.y >= screenRes.y) {
        return;
    }

    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(screenRes);

    vec3 albedo = texture(albedoImage, uv).rgb;
    vec3 normal = texture(normalImage, uv).rgb;     // world space, cleared to 0 where there is no geometry
    vec3 fragPos = texture(positionImage, uv).rgb;
    vec3 pbr = texture(pbrImage, uv).rgb;           // ao, roughness, metallic

    vec3 ddgi = vec3(0.0);
    if (pc.ddgiMode != 0 && length(normal) > 0.1) {
        vec3 N = normalize(normal);
        vec3 V = normalize(camera.invView[3].xyz - fragPos);
        DDGIVolume volume = DDGIVolume(pc.gridOrigin.xyz, pc.gridSpacing, pc.probeCounts.xyz, pc.normalBias);

        // this is the whole diffuse ambient: lightPass.frag skips its diffuse ibl while the probes are active.
        // outside the grid it falls back to the same open sky the light pass would have used
        vec4 irradiance = ddgiSampleIrradiance(fragPos, N, V, volume, lastFrameIrradianceAtlas, lastFrameVisibilityAtlas);
        vec3 ambient = mix(getSkyIrradiance(N) * pc.skyIntensity, irradiance.rgb / DDGI_PI * pc.ddgiIntensity, irradiance.a);
        ddgi = albedo * (1.0 - pbr.b) * pbr.r * ambient;
    }

    vec3 ssgi = texture(giImage, uv).rgb; // * vec3(1.0, 0.2, 1.0);

    vec3 ambient = ddgi + ssgi;
    vec3 sceneColor = texture(sceneImage, uv).rgb;
    vec3 bloom = texture(bloomImage, uv).rgb;

    vec3 finalColor = sceneColor + ambient + bloom * 1.0;
    finalColor = finalColor / (finalColor + vec3(1.0));
    finalColor = pow(finalColor, vec3(1.0/2.2));

    vec4 outColor;
    if(pc.ddgiMode == 2) {
        outColor = vec4(pow(ddgi / (ddgi + vec3(1.0)), vec3(1.0/2.2)), 1.0);
    } else if(pc.shouldCombine == 1) {
        outColor = vec4(finalColor, 1.0);
        // outColor = vec4(sceneColor, 1.0);
    } else {
        outColor = vec4(ambient, 1.0);
    }
    imageStore(outImage, pixelCoord, outColor);
}
