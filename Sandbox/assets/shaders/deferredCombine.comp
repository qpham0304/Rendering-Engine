#version 460

#extension GL_GOOGLE_include_directive : require

#include "common/ddgi.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraData {
    mat4 projection;
    mat4 view;
    mat4 invProj;
    mat4 invView;
} camera;

layout(set = 0, binding = 1, rgba16f) writeonly uniform image2D outImage;
layout(set = 0, binding = 2) uniform sampler2D giImage;          // diffuse ssgi: rgb = radiance * confidence, a = confidence
layout(set = 0, binding = 3) uniform sampler2D sceneImage;
layout(set = 0, binding = 4) uniform sampler2D albedoImage;
layout(set = 0, binding = 5) uniform sampler2D bloomImage;
layout(set = 0, binding = 6) uniform sampler2D lastFrameIrradianceAtlas;
layout(set = 0, binding = 7) uniform sampler2D positionImage;
layout(set = 0, binding = 8) uniform sampler2D normalImage;
layout(set = 0, binding = 9) uniform sampler2D lastFrameVisibilityAtlas;
layout(set = 0, binding = 10) uniform sampler2D pbrImage;
layout(set = 0, binding = 11) readonly buffer SHData {
    vec4 shCoeffs[9];
} sh;

// same SH the light pass uses for its diffuse ibl, already carries the 1 / PI
vec3 getSkyIrradiance(vec3 N) {
    return max(vec3(0.0),
        0.886227 * sh.shCoeffs[0].xyz +
        1.023328 * sh.shCoeffs[1].xyz * N.y +
        1.023328 * sh.shCoeffs[2].xyz * N.z +
        1.023328 * sh.shCoeffs[3].xyz * N.x +
        0.858086 * sh.shCoeffs[4].xyz * N.x * N.y +
        0.858086 * sh.shCoeffs[5].xyz * N.y * N.z +
        0.247708 * sh.shCoeffs[6].xyz * (3.0 * N.z * N.z - 1.0) +
        0.858086 * sh.shCoeffs[7].xyz * N.x * N.z +
        0.429043 * sh.shCoeffs[8].xyz * (N.x * N.x - N.y * N.y)
    );
}

layout(push_constant) uniform Constants {
    vec2 screenRes;
    float time;
    float frameSeed;
    int shouldCombine;
    float gridSpacing;
    uint probesPerDimension;
    vec4 gridOrigin;
    uint probesResolution;
    float normalBias;
    float ddgiIntensity;
    int ddgiMode;           // 0: off, 1: on, 2: show the ddgi term only
    ivec4 probeCounts;      // xyz: probes per axis
    float skyIntensity;
    int aoOn;
} pc;

layout(set = 0, binding = 12) uniform sampler2D specularGIImage;   // ssr, same layout as giImage
layout(set = 0, binding = 13) uniform samplerCube prefilterMap;
layout(set = 0, binding = 14) uniform sampler2D brdfLUT;
layout(set = 0, binding = 15) uniform sampler2D aoImage;

vec3 fresnelSchlickRoughness(float cosTheta, vec3 F0, float roughness) {
    return F0 + (max(vec3(1.0 - roughness), F0) - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

// all ambient light: the light pass only adds direct light and emissive. the traced ssgi / ssr give the incoming light
// where their rays hit something, the rest of the hemisphere (confidence 1 - a) falls back to the probes or the
// sky for diffuse and the prefiltered environment for specular, so nothing is counted twice
void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 screenRes = imageSize(outImage);
    if (pixelCoord.x >= screenRes.x || pixelCoord.y >= screenRes.y) {
        return;
    }

    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(screenRes);

    vec3 sceneColor = texture(sceneImage, uv).rgb;
    vec3 bloom = texture(bloomImage, uv).rgb;
    vec3 normal = texture(normalImage, uv).rgb;     // world space, cleared to 0 where there is no geometry

    // the sky is already in the scene color
    // for now, pixels from toon shader with pbr alpha 0, control it's own ambient
    if (length(normal) < 0.1 || texture(pbrImage, uv).a < 0.5) {
        imageStore(outImage, pixelCoord, vec4(pc.shouldCombine == 1 ? sceneColor + bloom : vec3(0.0), 1.0));
        return;
    }

    vec3 albedo = texture(albedoImage, uv).rgb;
    vec3 fragPos = texture(positionImage, uv).rgb;
    vec3 pbr = texture(pbrImage, uv).rgb;           // ao, roughness, metallic
    float roughness = max(pbr.g, 0.045);
    float metallic = pbr.b;
    float ao = pbr.r * (pc.aoOn != 0 ? texture(aoImage, uv).r : 1.0);

    vec3 N = normalize(normal);
    vec3 V = normalize(camera.invView[3].xyz - fragPos);
    float NdotV = clamp(dot(N, V), 0.001, 1.0);

    vec3 F0 = mix(vec3(0.04), albedo, metallic);
    vec3 F = fresnelSchlickRoughness(NdotV, F0, roughness);
    vec3 kD = (1.0 - F) * (1.0 - metallic);

    // incoming diffuse where the ssgi rays missed: the probes inside the grid, the open sky outside it
    DDGIVolume volume = DDGIVolume(pc.gridOrigin.xyz, pc.gridSpacing, pc.probeCounts.xyz, pc.normalBias);
    vec3 fallbackDiffuse = getSkyIrradiance(N);
    if (pc.ddgiMode != 0) {
        vec4 irradiance = ddgiSampleIrradiance(fragPos, N, V, volume, lastFrameIrradianceAtlas, lastFrameVisibilityAtlas);
        fallbackDiffuse = mix(getSkyIrradiance(N) * pc.skyIntensity, irradiance.rgb / DDGI_PI * pc.ddgiIntensity, irradiance.a);
    }

    vec4 diffuseGI = texture(giImage, uv);
    vec3 incomingDiffuse = diffuseGI.rgb + (1.0 - clamp(diffuseGI.a, 0.0, 1.0)) * fallbackDiffuse;
    vec3 diffuse = kD * albedo * incomingDiffuse * ao;

    // incoming specular where the ssr rays missed comes from the prefiltered environment, both are weighted
    // with the split sum the same way the light pass used to for the environment alone
    vec3 R = reflect(-V, N);
    vec3 prefiltered = textureLod(prefilterMap, R, roughness * 4.0).rgb;

    // the sky only shows through as much as the probes see it in the reflection direction: indoors they see walls,
    // so the missed reflection fades to their bounce light instead of the open sky
    vec3 fallbackSpecular = prefiltered;
    if (pc.ddgiMode != 0) {
        vec4 probe = ddgiSampleIrradiance(fragPos, R, V, volume, lastFrameIrradianceAtlas, lastFrameVisibilityAtlas);
        vec3 probeRadiance = probe.rgb / DDGI_PI * pc.ddgiIntensity;
        const vec3 lumaWeights = vec3(0.2126, 0.7152, 0.0722);
        float skyLum = dot(getSkyIrradiance(R) * pc.skyIntensity, lumaWeights);
        float skyVisibility = clamp(dot(probeRadiance, lumaWeights) / max(skyLum, 1e-4), 0.0, 1.0);
        vec3 smoothFallback = mix(probeRadiance, prefiltered, skyVisibility);
        vec3 occluded = mix(smoothFallback, probeRadiance, smoothstep(0.3, 0.8, roughness));
        fallbackSpecular = mix(prefiltered, occluded, probe.a);
    }

    vec4 specularGI = texture(specularGIImage, uv);
    vec3 incomingSpecular = specularGI.rgb + (1.0 - clamp(specularGI.a, 0.0, 1.0)) * fallbackSpecular;
    vec2 brdf = texture(brdfLUT, vec2(NdotV, roughness)).rg;
    vec3 specular = incomingSpecular * (F * brdf.x + brdf.y) * ao;

    vec3 ambient = diffuse + specular;

    // stays hdr, dlss upscales it and the tonemap pass maps it for display
    vec3 finalColor = sceneColor + ambient + bloom;

    vec4 outColor;
    if (pc.ddgiMode == 2) {
        outColor = vec4(kD * albedo * fallbackDiffuse * ao, 1.0);     // the probe term alone
    } else if (pc.shouldCombine == 1) {
        outColor = vec4(finalColor, 1.0);
    } else {
        outColor = vec4(ambient, 1.0);
    }
    imageStore(outImage, pixelCoord, outColor);
}
