#version 460

#extension GL_GOOGLE_include_directive : require

#include "common/mathUtils.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D inputImage;
layout(set = 0, binding = 1) uniform sampler2D depthImage;     // bilateral only, the input again for the others
layout(set = 0, binding = 2) writeonly uniform image2D outputImage;

const int BLUR_BOX = 0;
const int BLUR_GAUSSIAN = 1;
const int BLUR_BILATERAL = 2;

layout(push_constant) uniform Constants {
    mat4 invProj;
    int type;
    int radius;
    float sigma;
    float depthScale;
    int vertical;
} pc;

// view space distance so the edge weight is in world units no matter how far the pixel is
float linearDepth(ivec2 p, ivec2 size) {
    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    return -getPos(uv, texelFetch(depthImage, p, 0).r, pc.invProj, mat4(1.0)).z;
}

// one direction of a separable blur, run once horizontal and once vertical
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = textureSize(inputImage, 0);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    ivec2 direction = pc.vertical != 0 ? ivec2(0, 1) : ivec2(1, 0);
    float centerDepth = pc.type == BLUR_BILATERAL ? linearDepth(pixel, size) : 0.0;
    float twoSigma2 = 2.0 * max(pc.sigma * pc.sigma, 1e-4);

    vec4 total = vec4(0.0);
    float totalWeight = 0.0;
    for (int i = -pc.radius; i <= pc.radius; i++) {
        ivec2 sample_ = pixel + direction * i;
        if (sample_.x < 0 || sample_.x >= size.x || sample_.y < 0 || sample_.y >= size.y) {
            continue;
        }

        float weight = 1.0;
        if (pc.type != BLUR_BOX) {
            weight = exp(-float(i * i) / twoSigma2);
        }
        if (pc.type == BLUR_BILATERAL) {
            weight *= exp(-abs(centerDepth - linearDepth(sample_, size)) * pc.depthScale);
        }

        total += texelFetch(inputImage, sample_, 0) * weight;
        totalWeight += weight;
    }

    vec4 result = totalWeight > 0.0 ? total / totalWeight : texelFetch(inputImage, pixel, 0);
    imageStore(outputImage, pixel, result);
}
