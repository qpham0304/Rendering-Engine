#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_ray_query : require

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct Probe {
    vec4 position;
};

struct Material {
    uint albedoIdx;
    uint normalIdx;
    uint metalnessIdx;
    uint roughnessIdx;
    uint aoIdx;
    uint emissiveIdx;
    vec2 uvOffset;
    vec4 albedoFactor;
    vec4 normalFactor;
    float metallicFactor;
    float roughnessFactor;
    float aoFactor;
    float emissiveFactor;
};

const uint MAX_BONE_INFLUENCE = 4;
struct Vertex {
    vec3 pos;
    vec3 col;
    vec2 uv;
    vec3 normal;
    vec3 tangent;
    vec3 biTangent;
    int m_BoneIDs[MAX_BONE_INFLUENCE];
    float m_Weights[MAX_BONE_INFLUENCE];
};

struct Object {
    uint64_t vertexAddress;
    uint64_t indexAddress;
    uint64_t materialsRef;
    uint64_t materialIndiciesRef;
};

layout(buffer_reference, scalar) readonly buffer ObjectsBuffer { Object objects[]; };
layout(buffer_reference, scalar) readonly buffer Vertices      { Vertex v[]; };
layout(buffer_reference, scalar) readonly buffer Indices       { uint i[]; };
layout(buffer_reference, scalar) readonly buffer MaterialsBuffer { Material m[]; };
layout(buffer_reference, scalar) readonly buffer MatIndicesBuffer { uint i[]; };
layout(buffer_reference, scalar) readonly buffer ProbesBuffer { Probe p[]; };

layout(set = 0, binding = 0) uniform UniformBufferObject {
    mat4 view;
    mat4 prevViewProj;
    mat4 proj;
    vec4 cameraPos;
    mat4 invView;
    mat4 invProj;
    float width;
    float height;
    float frameSeed;
    int frameCount;
    int clear;
} ubo;

layout(set = 0, binding = 1) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 2, rgba16f) writeonly uniform image2D rayColorBuffer;
layout(set = 0, binding = 3, rg16f)   writeonly uniform image2D rayDistanceBuffer;
layout(set = 0, binding = 4) uniform sampler2D lastFrameIrradianceAtlas;
layout(set = 0, binding = 5) uniform sampler2D lastFrameVisibilityAtlas;
layout(set = 1, binding = 0) uniform sampler2D samplerImages[];

layout(push_constant) uniform PushConstant {
    ObjectsBuffer objRef;
    ProbesBuffer probRef;
    vec4 gridOrigin;
    uint probesPerDimension;
    uint probesResolution; 
    float gridSpacing;
    uint padding;
    vec3 lightDir;
} pc;

#define PI 3.14159265359

vec3 sphericalFibonacci(float i, float n) {
    const float PHI = sqrt(5.0) * 0.5 + 0.5;
    float phi = 2.0 * PI * (i * (PHI - 1.0) - floor(i * (PHI - 1.0)));
    float cosTheta = 1.0 - (2.0 * i + 1.0) / n;
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
    return vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
}

mat3 generateRandomRotation(float seed) {
    float angleX = fract(sin(seed * 12.9898) * 43758.5453) * 2.0 * PI;
    float angleY = fract(sin(seed * 78.233) * 43758.5453) * 2.0 * PI;
    float cx = cos(angleX), sx = sin(angleX);
    float cy = cos(angleY), sy = sin(angleY);
    mat3 rotX = mat3(1.0, 0.0, 0.0, 0.0, cx, sx, 0.0, -sx, cx);
    mat3 rotY = mat3(cy, 0.0, -sy, 0.0, 1.0, 0.0, sy, 0.0, cy);
    return rotX * rotY;
}

vec2 octEncode(vec3 v) {
    float l1norm = abs(v.x) + abs(v.y) + abs(v.z);
    vec2 result = v.xy * (1.0 / (l1norm > 0.0 ? l1norm : 1.0));
    if (v.z < 0.0) {
        vec2 signNotZero = vec2(result.x >= 0.0 ? 1.0 : -1.0, result.y >= 0.0 ? 1.0 : -1.0);
        result = (1.0 - abs(result.yx)) * signNotZero;
    }
    return result;
}

vec2 getAtlasUV(uint probeIdx, vec3 texturingDirection, uint stride, uint coreRes, vec2 totalAtlasSize) {
    vec2 octCoord = octEncode(normalize(texturingDirection));
    vec2 localUV = octCoord * 0.5 + 0.5;
    vec2 pixelCoordInTile = localUV * float(coreRes);
    uint tilesX = pc.probesPerDimension;
    ivec2 tileCoord = ivec2(probeIdx % tilesX, probeIdx / tilesX);
    vec2 finalPixelCoord = (vec2(tileCoord) * float(stride)) + vec2(1.0) + pixelCoordInTile;
    return finalPixelCoord / totalAtlasSize;
}

vec3 sampleDDGIIrradianceForTrace(vec3 worldPos, vec3 worldNorm, vec3 rayDirFromProbe) {
    vec3 biasedWorldPos = worldPos + worldNorm * 0.15;
    vec3 gridSpacePos = (biasedWorldPos - pc.gridOrigin.xyz) / pc.gridSpacing;
    
    if (any(lessThan(gridSpacePos, vec3(0.0))) || any(greaterThan(gridSpacePos, vec3(float(pc.probesPerDimension - 1))))) {
        return vec3(0.0);
    }
    
    ivec3 baseProbeXYZ = ivec3(floor(gridSpacePos));
    vec3 trilinearWeights = fract(gridSpacePos); 
    
    vec3 accumulatedIrradiance = vec3(0.0);
    float totalWeight = 0.0;
    
    uint totalProbes = pc.probesPerDimension * pc.probesPerDimension * pc.probesPerDimension;
    uint tilesX = pc.probesPerDimension;
    uint tilesY = (totalProbes + tilesX - 1) / tilesX;
    vec2 irrAtlasSize = vec2(tilesX * 10, tilesY * 10);
    vec2 visAtlasSize = vec2(tilesX * 18, tilesY * 18);

    for (int i = 0; i < 8; ++i) {
        ivec3 offset = ivec3(i & 1, (i >> 1) & 1, (i >> 2) & 1);
        ivec3 probeXYZ = clamp(baseProbeXYZ + offset, ivec3(0), ivec3(int(pc.probesPerDimension - 1)));
        
        uint probeIdx = uint(probeXYZ.x + (probeXYZ.z * int(pc.probesPerDimension)) + (probeXYZ.y * int(pc.probesPerDimension * pc.probesPerDimension)));
        
        vec3 spatialWeights = mix(1.0 - trilinearWeights, trilinearWeights, vec3(offset));
        float triWeight = spatialWeights.x * spatialWeights.y * spatialWeights.z;
        
        vec3 probePos = pc.gridOrigin.xyz + vec3(probeXYZ) * pc.gridSpacing;
        vec3 probeToPoint = biasedWorldPos - probePos;
        float distanceToProbe = length(probeToPoint);
        if (distanceToProbe < 0.0001) continue;
        
        vec3 directionToProbe = normalize(probeToPoint);
        
        vec2 visUV = getAtlasUV(probeIdx, directionToProbe, 18, 16, visAtlasSize);
        vec2 visibilityData = texture(lastFrameVisibilityAtlas, visUV).rg; 
        
        float mean = visibilityData.x;
        float variance = max(0.0001, visibilityData.y - (mean * mean));
        
        float chebyshevWeight = 1.0;
        if (distanceToProbe > mean) {
            float d = distanceToProbe - mean;
            chebyshevWeight = variance / (variance + d * d);
            chebyshevWeight = pow(max(0.0, chebyshevWeight), 8.0); 
        }
        
        float proximityFade = smoothstep(0.005, 0.06, abs(distanceToProbe - mean));
        chebyshevWeight = mix(1.0, chebyshevWeight, proximityFade);

        float cosineWeight = max(0.0, dot(-directionToProbe, worldNorm));
        float finalWeight = triWeight * max(0.001, cosineWeight) * max(0.001, chebyshevWeight);
        
        if (finalWeight > 0.0001) {
            vec2 irrUV = getAtlasUV(probeIdx, worldNorm, 10, 8, irrAtlasSize);
            vec3 irradianceSample = texture(lastFrameIrradianceAtlas, irrUV).rgb;
            accumulatedIrradiance += irradianceSample * finalWeight;
            totalWeight += finalWeight;
        }
    }
    
    if (totalWeight > 0.0) {
        accumulatedIrradiance /= totalWeight;
    }
    return accumulatedIrradiance;
}

void main() {
    uint probeIdx = gl_WorkGroupID.x;
    uint rayIdx = gl_LocalInvocationID.x;
    uint totalGridProbes = pc.probesPerDimension * pc.probesPerDimension * pc.probesPerDimension;
    if (probeIdx >= totalGridProbes) return;

    vec3 baseRayOrigin = pc.probRef.p[probeIdx].position.xyz;
    mat3 randomRot = generateRandomRotation(ubo.frameSeed + float(probeIdx));
    vec3 rayDir = randomRot * sphericalFibonacci(float(rayIdx), float(64));

    float selfShadowBias = 0.02;
    vec3 rayOrigin = baseRayOrigin + (rayDir * selfShadowBias);

    rayQueryEXT rayQuery;
    rayQueryInitializeEXT(rayQuery, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, rayOrigin, 0.001, rayDir, 10000.0);

    while(rayQueryProceedEXT(rayQuery)) {
        if(rayQueryGetIntersectionTypeEXT(rayQuery, false) == 1) {
            rayQueryConfirmIntersectionEXT(rayQuery);
        }
    }

    vec3 outRadiance = vec3(0.0);
    float hitDistance = 10000.0;

    if(rayQueryGetIntersectionTypeEXT(rayQuery, true) != 0) {
        hitDistance = rayQueryGetIntersectionTEXT(rayQuery, true);
        int customIndex = rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, true);
        int primitiveID = rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, true);
        vec2 baryCentrics = rayQueryGetIntersectionBarycentricsEXT(rayQuery, true);

        Object currentObj = pc.objRef.objects[customIndex];
        Vertices vertices = Vertices(currentObj.vertexAddress);
        Indices indices = Indices(currentObj.indexAddress);
        MaterialsBuffer materials = MaterialsBuffer(currentObj.materialsRef);
        MatIndicesBuffer matIndices = MatIndicesBuffer(currentObj.materialIndiciesRef);

        uint i0 = indices.i[primitiveID * 3 + 0];
        uint i1 = indices.i[primitiveID * 3 + 1];
        uint i2 = indices.i[primitiveID * 3 + 2];

        Vertex v0 = vertices.v[i0];
        Vertex v1 = vertices.v[i1];
        Vertex v2 = vertices.v[i2];

        vec3 bary = vec3(1.0 - baryCentrics.x - baryCentrics.y, baryCentrics.x, baryCentrics.y);
        vec2 uv = v0.uv * bary.x + v1.uv * bary.y + v2.uv * bary.z;
        vec3 worldNorm = normalize(v0.normal * bary.x + v1.normal * bary.y + v2.normal * bary.z);

        uint matIdx = matIndices.i[primitiveID];
        Material mat = materials.m[matIdx];

        vec3 albedo = mat.albedoFactor.rgb;
        if(mat.albedoIdx != uint(-1)) {
            albedo *= texture(samplerImages[nonuniformEXT(mat.albedoIdx)], uv).rgb;
        }

        vec3 emissive = vec3(0.0);
        if(mat.emissiveIdx != uint(-1)) {
            emissive = texture(samplerImages[nonuniformEXT(mat.emissiveIdx)], uv).rgb * mat.emissiveFactor;
        }

        vec3 N = worldNorm;
        vec3 L = normalize(-pc.lightDir.xyz);
        float diffuseTerm = max(0.0, dot(N, L));
        
        vec3 directLighting = (diffuseTerm * vec3(1.5)) * (1.0 / PI) * 0.0;
        vec3 hitPosition = baseRayOrigin + rayDir * hitDistance;
        vec3 indirectLighting = sampleDDGIIrradianceForTrace(hitPosition, N, rayDir);

        outRadiance = albedo * (directLighting + indirectLighting) + emissive;
    } else {
        hitDistance = pc.gridSpacing * 5.0;
        outRadiance = vec3(0.1, 0.15, 0.23) * (1.0 / PI); 
    }

    imageStore(rayColorBuffer, ivec2(rayIdx, probeIdx), vec4(outRadiance, 1.0));
    imageStore(rayDistanceBuffer, ivec2(rayIdx, probeIdx), vec4(hitDistance, hitDistance * hitDistance, 0.0, 1.0));
}