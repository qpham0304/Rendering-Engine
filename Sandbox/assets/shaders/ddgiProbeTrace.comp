#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_ray_query : require

#include "common/buffers.glsl"
#include "common/ddgi.glsl"

// one work group = one probe, one invocation = one ray (DDGI_RAYS_PER_PROBE)
layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform UniformBufferObject {
    mat4 randomRotation;    // same rotation for every probe this frame
    vec4 sunDirection;      // xyz: toward the sun
    vec4 sunColor;          // rgb: color * intensity
    float hysteresis;
    float maxRayDistance;
    float normalBias;
    uint clear;
    float skyIntensity;
} ubo;

layout(set = 0, binding = 1) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 2, rgba16f) writeonly uniform image2D rayColorBuffer;     // x: ray, y: probe
layout(set = 0, binding = 3, rg16f)   writeonly uniform image2D rayDistanceBuffer;  // x: ray, y: probe
layout(set = 0, binding = 4) uniform sampler2D lastFrameIrradianceAtlas;
layout(set = 0, binding = 5) uniform sampler2D lastFrameVisibilityAtlas;
layout(set = 0, binding = 6) readonly buffer SHData {
    vec4 shCoeffs[9];
} sh;
layout(set = 1, binding = 0) uniform sampler2D samplerImages[];

layout(push_constant) uniform PushConstant {
    uint64_t objectsRef;
    uint64_t lightsRef;
    vec4 gridOrigin;
    ivec4 probeCounts;      // xyz: probes per axis, w: total
    float gridSpacing;
    uint probesResolution;
    uint lightCount;
} pc;

#include "common/rayQueryLighting.glsl"

void main() {
    int probeIdx = int(gl_WorkGroupID.x);
    int rayIdx = int(gl_LocalInvocationID.x);
    ivec3 counts = pc.probeCounts.xyz;
    if (probeIdx >= pc.probeCounts.w) {
        return;
    }

    vec3 probePos = ddgiProbePosition(ddgiProbeCoord(probeIdx, counts), pc.gridOrigin.xyz, pc.gridSpacing);
    vec3 rayDir = normalize(mat3(ubo.randomRotation) * ddgiSphericalFibonacci(float(rayIdx), float(DDGI_RAYS_PER_PROBE)));

    rayQueryEXT rayQuery;
    rayQueryInitializeEXT(rayQuery, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, probePos, 0.0, rayDir, DDGI_MISS_DISTANCE);
    while (rayQueryProceedEXT(rayQuery)) {}

    // a miss sees the sky. the SH is the blurred environment, which is all a diffuse probe needs
    // and it keeps bright texels of the hdr from turning into fireflies
    vec3 radiance = getSkyIrradiance(rayDir) * ubo.skyIntensity;
    float hitDistance = DDGI_MISS_DISTANCE;

    if (rayQueryGetIntersectionTypeEXT(rayQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        float t = rayQueryGetIntersectionTEXT(rayQuery, true);
        int customIndex = rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, true);
        int primitiveID = rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, true);
        vec2 attribs = rayQueryGetIntersectionBarycentricsEXT(rayQuery, true);
        mat4x3 worldToObject = rayQueryGetIntersectionWorldToObjectEXT(rayQuery, true);

        Object obj = ObjectsBuffer(pc.objectsRef).objects[customIndex];
        Vertices vertices = Vertices(obj.vertexAddress);
        Indices indices = Indices(obj.indexAddress);
        MaterialsBuffer materials = MaterialsBuffer(obj.materialsRef);
        MaterialIndicesBuffer matIndices = MaterialIndicesBuffer(obj.materialIndicesRef);

        Vertex v0 = vertices.v[indices.i[primitiveID * 3 + 0]];
        Vertex v1 = vertices.v[indices.i[primitiveID * 3 + 1]];
        Vertex v2 = vertices.v[indices.i[primitiveID * 3 + 2]];

        vec3 bc = vec3(1.0 - attribs.x - attribs.y, attribs.x, attribs.y);
        vec2 uv = v0.uv * bc.x + v1.uv * bc.y + v2.uv * bc.z;
        vec3 nrmObject = v0.normal * bc.x + v1.normal * bc.y + v2.normal * bc.z;
        if (dot(nrmObject, nrmObject) < 1e-8) {
            nrmObject = cross(v1.pos - v0.pos, v2.pos - v0.pos);
        }
        vec3 N = normalize(vec3(nrmObject * worldToObject));

        if (dot(N, rayDir) > 0.0) {
            // back face: the probe is inside or behind geometry, no light comes from there.
            // the negative distance marks it for the update passes
            hitDistance = -t * 0.2;
        } else {
            hitDistance = t;

            Material mat = materials.m[matIndices.i[primitiveID]];
            vec2 matUV = uv + mat.uvOffset;
            vec3 albedo = textureLod(samplerImages[nonuniformEXT(mat.albedoIdx)], matUV, 0.0).rgb * mat.albedoFactor.rgb;
            vec3 emissive = textureLod(samplerImages[nonuniformEXT(mat.emissiveIdx)], matUV, 0.0).rgb * mat.emissiveFactor;

            vec3 hitPos = probePos + rayDir * t;

            vec3 L = normalize(ubo.sunDirection.xyz);
            float NdotL = max(dot(N, L), 0.0);
            vec3 sunIrradiance = vec3(0.0);
            if (NdotL > 0.0) {
                sunIrradiance = ubo.sunColor.rgb * NdotL * traceVisibility(hitPos + N * 0.01, L, DDGI_MISS_DISTANCE);
            }

            // last frame's probes light this hit, that is where the extra bounces (and the occluded sky) come from.
            // outside the grid, or with no history yet, fall back to the open sky. getSkyIrradiance carries a 1 / PI
            DDGIVolume volume = DDGIVolume(pc.gridOrigin.xyz, pc.gridSpacing, counts, ubo.normalBias);
            vec3 ambientIrradiance = getSkyIrradiance(N) * DDGI_PI * ubo.skyIntensity;
            if (ubo.clear == 0) {
                vec4 ddgi = ddgiSampleIrradiance(hitPos, N, -rayDir, volume, lastFrameIrradianceAtlas, lastFrameVisibilityAtlas);
                ambientIrradiance = mix(ambientIrradiance, ddgi.rgb, ddgi.a);
            }

            // light component lights, so their bounce ends up in the probes too
            vec3 localIrradiance = localLightIrradiance(hitPos + N * 0.01, N, pc.lightsRef, pc.lightCount);

            vec3 diffuse = albedo * (sunIrradiance + localIrradiance + ambientIrradiance) / DDGI_PI;
            radiance = diffuse + emissive;
        }
    }

    // one bad value would stay in the atlas forever through the hysteresis blend
    if (any(isnan(radiance)) || any(isinf(radiance))) {
        radiance = vec3(0.0);
    }

    imageStore(rayColorBuffer, ivec2(rayIdx, probeIdx), vec4(radiance, 1.0));
    imageStore(rayDistanceBuffer, ivec2(rayIdx, probeIdx), vec4(hitDistance, 0.0, 0.0, 0.0));
}
