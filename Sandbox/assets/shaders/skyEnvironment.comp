#version 460

#extension GL_GOOGLE_include_directive : require

#include "common/atmosphere.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D transmittanceLut;
layout(binding = 1) uniform sampler2D multiScatteringLut;
layout(binding = 2, rgba16f) uniform writeonly image2D environmentMap;

const int STEPS = 40;

// inverse of sampleSphericalMap in the light pass, the ibl reads this the same way as a loaded hdr
vec3 equirectDirection(vec2 uv) {
    float phi = (uv.x - 0.5) * 2.0 * ATMOSPHERE_PI;
    float latitude = (uv.y - 0.5) * ATMOSPHERE_PI;
    vec3 lookup = vec3(cos(latitude) * cos(phi), sin(latitude), cos(latitude) * sin(phi));
    return vec3(lookup.x, lookup.y, -lookup.z);
}

// sky radiance seen from the viewer: single scattering with the sun shadowed by the transmittance lut,
// plus the multiple scattering lut, integrated along the view ray. no sun disk, the sun is the directional light
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(environmentMap);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    vec3 dir = normalize(equirectDirection((vec2(pixel) + 0.5) / vec2(size)));
    vec3 sunDir = normalize(atmosphere.sunDirection.xyz);
    vec3 pos = vec3(0.0, atmosphere.bottomRadius + atmosphere.viewHeight, 0.0);

    float tGround = raySphere(pos, dir, atmosphere.bottomRadius);
    float tMax = tGround > 0.0 ? tGround : raySphere(pos, dir, atmosphere.topRadius);

    float cosTheta = dot(dir, sunDir);
    float phaseRayleigh = rayleighPhase(cosTheta);
    float phaseMie = miePhase(cosTheta, atmosphere.mie.w);

    vec3 luminance = vec3(0.0);
    vec3 throughput = vec3(1.0);
    float tPrevious = 0.0;
    for (int i = 0; i < STEPS; i++) {
        // squared distribution, short steps near the viewer where the density and the horizon detail are
        float tNext = tMax * pow((float(i) + 1.0) / float(STEPS), 2.0);
        float dt = tNext - tPrevious;
        vec3 p = pos + dir * (tPrevious + dt * 0.3);
        tPrevious = tNext;

        float radius = length(p);
        MediumSample medium = sampleMedium(radius - atmosphere.bottomRadius);
        vec3 extinction = max(medium.extinction, vec3(1e-7));
        vec3 stepTransmittance = exp(-extinction * dt);

        vec2 lutUV = atmosphereLutUV(radius, dot(p / radius, sunDir));
        vec3 sunTransmittance = textureLod(transmittanceLut, lutUV, 0.0).rgb;
        vec3 multiScattering = textureLod(multiScatteringLut, lutUV, 0.0).rgb;

        vec3 inScattering = medium.rayleighScattering * (phaseRayleigh * sunTransmittance + multiScattering)
                          + medium.mieScattering * (phaseMie * sunTransmittance + multiScattering);

        luminance += throughput * (inScattering - inScattering * stepTransmittance) / extinction;
        throughput *= stepTransmittance;
    }

    // below the horizon the planet surface, lit by the sun through the atmosphere
    if (tGround > 0.0) {
        vec3 groundPos = pos + dir * tGround;
        vec3 groundNormal = normalize(groundPos);
        float NdotL = max(dot(groundNormal, sunDir), 0.0);
        vec3 sunTransmittance = textureLod(transmittanceLut, atmosphereLutUV(length(groundPos), dot(groundNormal, sunDir)), 0.0).rgb;
        luminance += throughput * sunTransmittance * NdotL * atmosphere.groundAlbedo.rgb / ATMOSPHERE_PI;
    }

    luminance *= atmosphere.sunIlluminance.rgb;
    if (any(isnan(luminance)) || any(isinf(luminance))) {
        luminance = vec3(0.0);
    }

    imageStore(environmentMap, pixel, vec4(luminance, 1.0));
}
