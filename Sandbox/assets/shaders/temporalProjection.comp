#version 460

layout(local_size_x = 16, local_size_y = 16) in;

shared vec3 s_Colors[18][18];

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D u_FinalOutput;
layout(set = 0, binding = 1) uniform sampler2D u_CurrentNoisyGI;
layout(set = 0, binding = 2) uniform sampler2D u_HistoryGI;
layout(set = 0, binding = 3) uniform sampler2D u_MotionVectors;
layout(set = 0, binding = 4) uniform sampler2D u_CurrDepth;
layout(set = 0, binding = 5) uniform sampler2D u_PrevDepth;

layout(push_constant) uniform Constants {
    vec2 screenRes;
} pc;

vec3 RGBToYCoCg(vec3 rgb) {
    float Y = dot(rgb, vec3(0.25, 0.5, 0.25));
    float Co = dot(rgb, vec3(0.5, 0.0, -0.5));
    float Cg = dot(rgb, vec3(-0.25, 0.5, -0.25));
    return vec3(Y, Co, Cg);
}

vec3 YCoCgToRGB(vec3 ycocg) {
    return vec3(
        ycocg.x + ycocg.y - ycocg.z,
        ycocg.x + ycocg.z,
        ycocg.x - ycocg.y - ycocg.z
    );
}

// Tone mapping to stabilize high-frequency noise
float luminance(vec3 c) { return dot(c, vec3(0.2127, 0.7152, 0.0722)); }
vec3 fast_tonemap(vec3 c) { return c * (1.0 / (1.0 + luminance(c))); }
vec3 fast_un_tonemap(vec3 c) { return c * (1.0 / (1.0 - luminance(c))); }

void loadTileToShared(ivec2 gID, ivec2 lID) {
    ivec2 base = gID - lID - 1;
    for (int i = 0; i < 4; ++i) {
        ivec2 offset = ivec2((i % 2) * 16, (i / 2) * 16);
        ivec2 localPos = lID + offset;
        if (localPos.x < 18 && localPos.y < 18) {
            vec2 loadUV = (vec2(base + localPos) + 0.5) / pc.screenRes;
            s_Colors[localPos.x][localPos.y] = texture(u_CurrentNoisyGI, loadUV).rgb;
        }
    }
}

void main() {
    ivec2 gID = ivec2(gl_GlobalInvocationID.xy);
    ivec2 lID = ivec2(gl_LocalInvocationID.xy);
    vec2 uv = (vec2(gID) + 0.5) / pc.screenRes;

    loadTileToShared(gID, lID);
    barrier();

    vec2 velocity = texture(u_MotionVectors, uv).rg;
    vec2 prevUV = uv - velocity;

    vec3 m1 = vec3(0.0);
    vec3 m2 = vec3(0.0);
    
    // 3x3 Neighborhood stats in YCoCg
    for (int y = 0; y < 3; ++y) {
        for (int x = 0; x < 3; ++x) {
            vec3 c = RGBToYCoCg(max(vec3(0.0), s_Colors[lID.x + x][lID.y + y]));
            m1 += c;
            m2 += c * c;
        }
    }

    vec3 mean = m1 / 9.0;
    vec3 stddev = sqrt(max(vec3(0.0), (m2 / 9.0) - (mean * mean)));
    
    // Increased variance scale for GI stability (prevents over-clamping)
    float scale = 2.0; 
    vec3 minColor = mean - stddev * scale;
    vec3 maxColor = mean + stddev * scale;

    vec3 currentRGB = max(vec3(0.0), s_Colors[lID.x + 1][lID.y + 1]);
    vec4 historyData = texture(u_HistoryGI, prevUV);
    
    vec3 currentYCoCg = RGBToYCoCg(currentRGB);
    vec3 historyYCoCg = RGBToYCoCg(max(vec3(0.0), historyData.rgb));
    
    // Soft-clipping/Clipping instead of hard clamping reduces "boiling" noise
    historyYCoCg = clamp(historyYCoCg, minColor, maxColor);

    float currD = texture(u_CurrDepth, uv).r;
    float prevD = texture(u_PrevDepth, prevUV).r;
    
    bool disoccluded = abs(currD - prevD) > 0.005 || any(lessThan(prevUV, vec2(0.0))) || any(greaterThan(prevUV, vec2(1.0)));

    // Use higher max accumulation for GI (up to 64 or 128) to stop the jitter
    float accumulation = disoccluded ? 1.0 : min(historyData.a + 1.0, 64.0);
    
    // Anti-flicker weighting: blend slower if the current pixel is a massive outlier
    float weight = 1.0 / accumulation;
    float lumaCurr = luminance(currentRGB);
    float lumaHist = luminance(historyData.rgb);
    weight *= (1.0 / (1.0 + abs(lumaCurr - lumaHist)));

    vec3 resolvedYCoCg = mix(historyYCoCg, currentYCoCg, max(weight, 0.02)); 
    vec3 resultRGB = max(vec3(0.0), YCoCgToRGB(resolvedYCoCg));

    imageStore(u_FinalOutput, gID, vec4(resultRGB, accumulation));
}