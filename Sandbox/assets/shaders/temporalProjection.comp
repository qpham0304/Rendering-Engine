#version 460

layout(local_size_x = 16, local_size_y = 16) in;

// this frame's noisy ssrgi around the group, one texel border for the 3x3 neighborhood
shared vec4 s_Diffuse[18][18];
shared vec4 s_Specular[18][18];

// diffuse and specular are both rgb = radiance * confidence, a = confidence (see ssrgi.glsl)
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D u_OutDiffuse;
layout(set = 0, binding = 1) uniform sampler2D u_CurrentDiffuse;
layout(set = 0, binding = 2) uniform sampler2D u_HistoryDiffuse;
layout(set = 0, binding = 3) uniform sampler2D u_MotionVectors;
layout(set = 0, binding = 4) uniform sampler2D u_CurrDepth;
layout(set = 0, binding = 5) uniform sampler2D u_PrevDepth;

layout(set = 0, binding = 6) uniform CameraData {
    mat4 invViewProj;
    mat4 priorViewProj;
} camera;

layout(set = 0, binding = 7) uniform sampler2D u_CurrNormal;
layout(set = 0, binding = 8) uniform sampler2D u_PrevNormal;
layout(set = 0, binding = 9) uniform sampler2D u_PBR;         // ao, roughness, metallic
layout(set = 0, binding = 10, rgba16f) uniform writeonly image2D u_OutSpecular;
layout(set = 0, binding = 11) uniform sampler2D u_CurrentSpecular;
layout(set = 0, binding = 12) uniform sampler2D u_HistorySpecular;
layout(set = 0, binding = 13, r16f) uniform writeonly image2D u_OutLength;
layout(set = 0, binding = 14) uniform sampler2D u_HistoryLength;   // frames accumulated so far

layout(push_constant) uniform Constants {
    mat4 invProj;           // y flipped like ubo.invProj, only used to linearize depth
    vec2 screenRes;
    float maxHistoryRough;
    float maxHistorySmooth;
    float maxHistoryMoving;
    float clampGamma;       // neighborhood box half size in standard deviations
    float depthTolerance;   // relative view depth
    float normalThreshold;
} pc;

float linearDepth(float depth) {
    vec4 view = pc.invProj * vec4(0.0, 0.0, depth, 1.0);
    return -view.z / view.w;
}

void loadTileToShared(ivec2 gID, ivec2 lID) {
    ivec2 base = gID - lID - 1;
    for (int i = 0; i < 4; ++i) {
        ivec2 localPos = lID + ivec2((i % 2) * 16, (i / 2) * 16);
        if (localPos.x < 18 && localPos.y < 18) {
            vec2 loadUV = (vec2(base + localPos) + 0.5) / pc.screenRes;
            s_Diffuse[localPos.x][localPos.y] = max(texture(u_CurrentDiffuse, loadUV), vec4(0.0));
            s_Specular[localPos.x][localPos.y] = max(texture(u_CurrentSpecular, loadUV), vec4(0.0));
        }
    }
}

// mean +- gamma * standard deviation of the 3x3 around the pixel, what this frame says the value can be
void neighborhoodBox(ivec2 lID, bool specular, out vec4 boxMin, out vec4 boxMax) {
    vec4 m1 = vec4(0.0);
    vec4 m2 = vec4(0.0);
    for (int y = 0; y < 3; ++y) {
        for (int x = 0; x < 3; ++x) {
            vec4 c = specular ? s_Specular[lID.x + x][lID.y + y] : s_Diffuse[lID.x + x][lID.y + y];
            m1 += c;
            m2 += c * c;
        }
    }
    vec4 mean = m1 / 9.0;
    vec4 stddev = sqrt(max(vec4(0.0), m2 / 9.0 - mean * mean));
    boxMin = mean - (stddev * pc.clampGamma + 0.01);
    boxMax = mean + (stddev * pc.clampGamma + 0.01);
}

// reprojects last frame's accumulated diffuse and specular with the motion vectors, keeps the history only where the
// same surface was there (view depth and normal), clamps it to this frame's neighborhood so it can't hold on to light
// that is gone (ghosts behind moving objects) and blends this frame in with 1 / frames accumulated
void main() {
    ivec2 gID = ivec2(gl_GlobalInvocationID.xy);
    ivec2 lID = ivec2(gl_LocalInvocationID.xy);

    loadTileToShared(gID, lID);
    barrier();

    if (gID.x >= int(pc.screenRes.x) || gID.y >= int(pc.screenRes.y)) {
        return;
    }

    vec2 uv = (vec2(gID) + 0.5) / pc.screenRes;
    vec2 velocity = texture(u_MotionVectors, uv).rg;
    vec2 prevUV = uv - velocity;

    vec3 currNormal = texture(u_CurrNormal, uv).xyz;
    float currDepth = linearDepth(texture(u_CurrDepth, uv).r);

    // bilinear history, each of the 4 texels only counts when it shows the same surface
    vec2 prevPixelPos = prevUV * pc.screenRes - 0.5;
    ivec2 baseCoord = ivec2(floor(prevPixelPos));
    vec2 f = fract(prevPixelPos);

    vec4 historyDiffuse = vec4(0.0);
    vec4 historySpecular = vec4(0.0);
    float historyLength = 0.0;
    float totalWeight = 0.0;
    for (int y = 0; y <= 1; y++) {
        for (int x = 0; x <= 1; x++) {
            ivec2 coord = baseCoord + ivec2(x, y);
            if (any(lessThan(coord, ivec2(0))) || any(greaterThanEqual(coord, ivec2(pc.screenRes)))) {
                continue;
            }

            vec2 sampleUV = (vec2(coord) + 0.5) / pc.screenRes;
            vec3 hNormal = texture(u_PrevNormal, sampleUV).xyz;
            float hDepth = linearDepth(texture(u_PrevDepth, sampleUV).r);

            // relative in view space: raw depth is non linear, a fixed threshold accepts almost anything far away
            // and rejects the sub pixel jitter dlss adds every frame up close
            bool normalMatch = dot(currNormal, hNormal) > pc.normalThreshold;
            bool depthMatch = abs(currDepth - hDepth) < pc.depthTolerance * currDepth;
            if (!normalMatch || !depthMatch) {
                continue;
            }

            vec4 d = texture(u_HistoryDiffuse, sampleUV);
            vec4 s = texture(u_HistorySpecular, sampleUV);
            if (any(isnan(d)) || any(isinf(d)) || any(isnan(s)) || any(isinf(s))) {
                continue;
            }

            float w = (x == 0 ? 1.0 - f.x : f.x) * (y == 0 ? 1.0 - f.y : f.y);
            historyDiffuse += d * w;
            historySpecular += s * w;
            historyLength += texture(u_HistoryLength, sampleUV).r * w;
            totalWeight += w;
        }
    }

    vec4 currentDiffuse = s_Diffuse[lID.x + 1][lID.y + 1];
    vec4 currentSpecular = s_Specular[lID.x + 1][lID.y + 1];

    vec4 resultDiffuse = currentDiffuse;
    vec4 resultSpecular = currentSpecular;
    float nextLength = 1.0;

    if (totalWeight > 0.001) {
        historyDiffuse /= totalWeight;
        historySpecular /= totalWeight;
        historyLength /= totalWeight;

        // a moving pixel blends faster, its reprojection is never exact
        float speed = length(velocity * pc.screenRes);
        historyLength = mix(historyLength, min(historyLength, pc.maxHistoryMoving), clamp(speed * 2.0, 0.0, 1.0));

        vec4 boxMin, boxMax;
        neighborhoodBox(lID, false, boxMin, boxMax);
        historyDiffuse = clamp(historyDiffuse, boxMin, boxMax);
        neighborhoodBox(lID, true, boxMin, boxMax);
        historySpecular = clamp(historySpecular, boxMin, boxMax);

        nextLength = historyLength + 1.0;

        // diffuse doesn't depend on the view so it can average long, a sharp reflection follows the view and
        // only gets a short history, rough reflections are close to diffuse
        float roughness = texture(u_PBR, uv).g;
        float maxSpecular = mix(pc.maxHistorySmooth, pc.maxHistoryRough, smoothstep(0.05, 0.6, roughness));
        float alphaDiffuse = 1.0 / min(nextLength, pc.maxHistoryRough);
        float alphaSpecular = 1.0 / min(nextLength, maxSpecular);

        resultDiffuse = mix(historyDiffuse, currentDiffuse, alphaDiffuse);
        resultSpecular = mix(historySpecular, currentSpecular, alphaSpecular);
        nextLength = min(nextLength, max(pc.maxHistoryRough, pc.maxHistorySmooth));
    }

    imageStore(u_OutDiffuse, gID, max(resultDiffuse, vec4(0.0)));
    imageStore(u_OutSpecular, gID, max(resultSpecular, vec4(0.0)));
    imageStore(u_OutLength, gID, vec4(nextLength));
}
