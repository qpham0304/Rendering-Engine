#version 460

#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : enable

// Process the Irradiance Atlas in 8x8 blocks of texels, prop resolution 8x8
layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform UniformBufferObject {
    mat4 view;
    mat4 prevViewProj;
    mat4 proj;
    vec4 cameraPos;
    mat4 invView;
    mat4 invProj;
    float width;
    float height;
    float frameSeed; // Must match the exact seed used in the trace shader this frame
    int frameCount;
    int clear;
} ubo;

layout(set = 0, binding = 1, rgba16f) writeonly uniform image2D currentIrradianceAtlas;
layout(set = 0, binding = 2) uniform sampler2D lastFrameIrradianceAtlas;
layout(set = 0, binding = 3) uniform sampler2D rayColorBufferSampler;
layout(set = 0, binding = 4) uniform sampler2D rayDistanceBufferSampler;
layout(set = 0, binding = 5, rg16f) writeonly uniform image2D currentVisibilityAtlas;
layout(set = 0, binding = 6) uniform sampler2D lastFrameVisibilityAtlas; // Add this

layout(push_constant) uniform PushConstant {
    uint probesPerDimension;
    uint probesResolution;      // Resolution of a probe tile (e.g., 8)
    uint numRaysPerProbe;       // Number of rays shot per probe (e.g., 64)
} pc;

// Decodes a 2D octahedral coordinate [-1, 1] back into a normalized 3D world direction
vec3 octDecode(vec2 uv) {
    vec3 v = vec3(uv.x, uv.y, 1.0 - abs(uv.x) - abs(uv.y));
    if (v.z < 0.0) {
        v.xy = (1.0 - abs(v.yx)) * vec2(v.x >= 0.0 ? 1.0 : -1.0, v.y >= 0.0 ? 1.0 : -1.0);
    }
    return normalize(v);
}

// Spherical Fibonacci generator this must match the probe tracing pass
vec3 getFibonacciDirection(int sampleIdx, int numSamples, float frameSeed) {
    const float PI = 3.14159265359;
    const float GOLDEN_RATIO = 2.39996323; 

    float i = float(sampleIdx) + 0.5;
    float phi = acos(1.0 - 2.0 * i / float(numSamples));
    float theta = i * GOLDEN_RATIO + frameSeed; 

    return vec3(sin(phi) * cos(theta), sin(phi) * sin(theta), cos(phi));
}

void main() {
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 atlasSize = textureSize(lastFrameIrradianceAtlas, 0);
    
    // Out-of-bounds guard for safety
    if (pixelCoords.x >= atlasSize.x || pixelCoords.y >= atlasSize.y) {
        return;
    }

    int probRes = int(pc.probesResolution);
    int probesPerRow = atlasSize.x / probRes;
    
    // Find out which probe identity this pixel belongs to based on tile location
    int probeX = pixelCoords.x / probRes;
    int probeY = pixelCoords.y / probRes;
    int probeID = probeX + (probeY * probesPerRow);

    // Identify the local texel coordinate within this specific 8x8 probe tile
    ivec2 localTexel = pixelCoords % probRes;

    // Skip the 1-pixel border of the tile during the gathering loop.
    // The borders are updated via copies/wrap padding afterwards to allow seamless bilinear filtering.
    if (localTexel.x == 0 || localTexel.x == (probRes - 1) || localTexel.y == 0 || localTexel.y == (probRes - 1)) {
        return; 
    }

    // Map inner active 6x6 texels to normalized [-1, 1] octahedral coordinate space
    // Scale coordinates cleanly to span across the active interior region
    // the static world-space normal direction this specific texel represents
    vec2 localUV = (vec2(localTexel) - 1.0) / float(probRes - 3); 
    vec2 octCoord = localUV * 2.0 - 1.0;
    vec3 texelDir = octDecode(octCoord);
    // vec3 texelDir = vec3(0, 1, 0);

    vec4 irradianceSum = vec4(0.0);
    vec3 visibilitySum = vec3(0.0); // Mean dist, Mean dist squared, Total Weight
    
    int numRays = int(pc.numRaysPerProbe);

    for (int r = 0; r < numRays; r++) {
        vec3 rayDir = getFibonacciDirection(r, numRays, ubo.frameSeed);
        float weight = max(0.0, dot(texelDir, rayDir));
        
        if (weight > 0.0) {
            ivec2 rayBufferCoord = ivec2(r, probeID);
            
            // --- Irradiance Gathering ---
            float iWeight = pow(weight, 2.0); // Standard cosine power
            vec3 rayColor = texelFetch(rayColorBufferSampler, rayBufferCoord, 0).rgb;
            irradianceSum += vec4(rayColor * iWeight, iWeight);

            // --- Visibility Gathering ---
            // McGuire recommends a higher power for visibility to reduce "leaking"
            float vWeight = pow(weight, 64.0); 
            vec2 rayDist = texelFetch(rayDistanceBufferSampler, rayBufferCoord, 0).rg;
            visibilitySum += vec3(rayDist * vWeight, vWeight);
        }
    }
    
    vec3 frameIrradiance = irradianceSum.rgb / max(irradianceSum.a, 1e-4);
    vec3 oldIrradiance = texelFetch(lastFrameIrradianceAtlas, pixelCoords, 0).rgb;
    float hysteresis = (ubo.clear == 1) ? 0.0 : 0.97;
    
    vec3 finalIrradiance = mix(frameIrradiance, oldIrradiance, hysteresis);
    imageStore(currentIrradianceAtlas, pixelCoords, vec4(finalIrradiance, 1.0));

    vec2 frameVisibility = visibilitySum.xy / max(visibilitySum.z, 1e-4);
    vec2 oldVisibility = texelFetch(lastFrameVisibilityAtlas, pixelCoords, 0).rg;
    
    // Visibility usually reacts better with slightly lower hysteresis than lighting
    float vHysteresis = (ubo.clear == 1) ? 0.0 : 0.95; 
    vec2 finalVisibility = mix(frameVisibility, oldVisibility, vHysteresis);
    
    imageStore(currentVisibilityAtlas, pixelCoords, vec4(finalVisibility, 0.0, 1.0));
}