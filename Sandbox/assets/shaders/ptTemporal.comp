#version 460

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D u_Noisy;          // this frame's demodulated light
layout(set = 0, binding = 1, rgba32f) uniform readonly image2D u_Position;       // world xyz, w = 1 on geometry
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D u_Normal;
layout(set = 0, binding = 3, rgba32f) uniform readonly image2D u_PrevPosition;
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D u_PrevNormal;
layout(set = 0, binding = 5, rgba16f) uniform readonly image2D u_HistoryColor;   // rgb, a = variance
layout(set = 0, binding = 6, rgba16f) uniform readonly image2D u_HistoryMoments; // luminance, luminance squared, length
layout(set = 0, binding = 7, rgba16f) uniform writeonly image2D u_OutColor;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D u_OutMoments;

layout(push_constant) uniform Constants {
    mat4 prevViewProj;      // y flipped like the ray generation, unjittered
    vec4 cameraPos;
    ivec2 resolution;
    float maxHistory;
    float normalThreshold;
    float positionTolerance;    // relative to the distance from the camera
} pc;

float luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// svgf style temporal accumulation: last frame's result where the same surface was there (position and normal),
// plus the first two moments of the luminance so the a-trous pass knows how noisy each pixel still is
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= pc.resolution.x || pixel.y >= pc.resolution.y) {
        return;
    }

    vec4 position = imageLoad(u_Position, pixel);
    if (position.w <= 0.0) {
        imageStore(u_OutColor, pixel, vec4(0.0));
        imageStore(u_OutMoments, pixel, vec4(0.0));
        return;
    }

    vec3 color = imageLoad(u_Noisy, pixel).rgb;
    vec3 normal = imageLoad(u_Normal, pixel).xyz;
    float lum = luminance(color);
    float tolerance = pc.positionTolerance * max(length(position.xyz - pc.cameraPos.xyz), 0.1);

    vec4 clip = pc.prevViewProj * vec4(position.xyz, 1.0);
    vec2 prevUV = clip.xy / clip.w * 0.5 + 0.5;
    vec2 prevPixel = prevUV * vec2(pc.resolution) - 0.5;
    ivec2 base = ivec2(floor(prevPixel));
    vec2 f = fract(prevPixel);

    vec3 historyColor = vec3(0.0);
    vec3 historyMoments = vec3(0.0);
    float totalWeight = 0.0;
    if (clip.w > 0.0) {
        for (int y = 0; y <= 1; y++) {
            for (int x = 0; x <= 1; x++) {
                ivec2 coord = base + ivec2(x, y);
                if (any(lessThan(coord, ivec2(0))) || any(greaterThanEqual(coord, pc.resolution))) {
                    continue;
                }
                vec4 prevPosition = imageLoad(u_PrevPosition, coord);
                vec3 prevNormal = imageLoad(u_PrevNormal, coord).xyz;
                if (prevPosition.w <= 0.0 || length(prevPosition.xyz - position.xyz) > tolerance
                    || dot(prevNormal, normal) < pc.normalThreshold) {
                    continue;
                }
                float w = (x == 0 ? 1.0 - f.x : f.x) * (y == 0 ? 1.0 - f.y : f.y);
                historyColor += imageLoad(u_HistoryColor, coord).rgb * w;
                historyMoments += imageLoad(u_HistoryMoments, coord).xyz * w;
                totalWeight += w;
            }
        }
    }

    float historyLength = 0.0;
    vec2 moments = vec2(lum, lum * lum);
    if (totalWeight > 0.001) {
        historyColor /= totalWeight;
        historyMoments /= totalWeight;
        historyLength = min(historyMoments.z + 1.0, pc.maxHistory);
        float alpha = 1.0 / historyLength;
        color = mix(historyColor, color, alpha);
        moments = mix(historyMoments.xy, moments, alpha);
    } else {
        historyLength = 1.0;
    }

    // a fresh history has too few frames for its own variance, assume it is very noisy so the spatial filter blurs it
    float variance = max(moments.y - moments.x * moments.x, 0.0);
    if (historyLength < 4.0) {
        variance = max(variance, lum * lum * (4.0 / historyLength));
    }

    if (any(isnan(color)) || any(isinf(color))) {
        color = vec3(0.0);
        variance = 0.0;
    }

    imageStore(u_OutColor, pixel, vec4(color, variance));
    imageStore(u_OutMoments, pixel, vec4(moments, historyLength, 0.0));
}
