#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_gpu_shader_int64 : require

#include "common/ddgi.glsl"

// dispatched over the whole atlas, one invocation = one atlas texel (border texels included)
layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform UniformBufferObject {
    mat4 randomRotation;
    vec4 sunDirection;
    vec4 sunColor;
    float hysteresis;
    float maxRayDistance;
    float normalBias;
    uint clear;
    float skyIntensity;
} ubo;

layout(set = 0, binding = 1) uniform sampler2D rayDistanceBuffer;   // x: ray, y: probe
layout(set = 0, binding = 2) uniform sampler2D lastFrameVisibilityAtlas;
layout(set = 0, binding = 3, rg16f) writeonly uniform image2D currentFrameVisibilityAtlas;

layout(push_constant) uniform PushConstant {
    uint64_t objectsRef;
    uint64_t padding;
    vec4 gridOrigin;
    ivec4 probeCounts;      // xyz: probes per axis, w: total
    float gridSpacing;
    uint probesResolution;
} pc;

// higher = sharper shadow edges between probes but more noise
const float DEPTH_SHARPNESS = 50.0;

void main() {
    const int stride = DDGI_VISIBILITY_RES + 2;
    ivec3 counts = pc.probeCounts.xyz;

    ivec2 atlasTexel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 atlasSize = ddgiAtlasSize(DDGI_VISIBILITY_RES, counts);
    if (any(greaterThanEqual(atlasTexel, atlasSize))) {
        return;
    }

    ivec2 tile = atlasTexel / stride;
    int probeIdx = tile.x + tile.y * counts.x;
    vec3 texelDirection = ddgiTexelDirection(atlasTexel % stride, DDGI_VISIBILITY_RES);

    vec2 sumMoments = vec2(0.0);
    float sumWeight = 0.0;

    for (int r = 0; r < DDGI_RAYS_PER_PROBE; r++) {
        // has to be the exact direction the trace pass used for this ray
        vec3 rayDir = normalize(mat3(ubo.randomRotation) * ddgiSphericalFibonacci(float(r), float(DDGI_RAYS_PER_PROBE)));
        float weight = pow(max(0.0, dot(texelDirection, rayDir)), DEPTH_SHARPNESS);

        // back faces are stored negative and shortened, a probe inside a wall ends up seeing almost nothing.
        // clamped so the squared distance stays inside 16 bit float range
        float rayDistance = min(abs(texelFetch(rayDistanceBuffer, ivec2(r, probeIdx), 0).r), ubo.maxRayDistance);

        sumMoments += vec2(rayDistance, rayDistance * rayDistance) * weight;
        sumWeight += weight;
    }

    // border texels read their own history, it is the same value as the interior texel they duplicate
    vec2 result = texelFetch(lastFrameVisibilityAtlas, atlasTexel, 0).rg;
    if (sumWeight > 0.0001) {
        vec2 current = sumMoments / sumWeight;
        result = (ubo.clear == 1) ? current : mix(current, result, ubo.hysteresis);
    }

    imageStore(currentFrameVisibilityAtlas, atlasTexel, vec4(result, 0.0, 0.0));
}
