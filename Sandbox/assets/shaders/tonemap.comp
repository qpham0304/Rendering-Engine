#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D hdrImage;
layout(set = 0, binding = 1, rgba16f) writeonly uniform image2D outImage;

layout(push_constant) uniform Constants {
    int tonemapper;     // 0 none, 1 reinhard, 2 aces narkowicz, 3 aces hill, 4 uncharted 2, 5 agx, 6 khronos pbr neutral
    float exposure;
    float invGamma;
} pc;

vec3 reinhard(vec3 x) {
    return x / (x + vec3(1.0));
}

// Krzysztof Narkowicz, single curve fit of the ACES rrt + odt
vec3 acesNarkowicz(vec3 x) {
    x *= 0.6;
    return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
}

// Stephen Hill, fitted ACES with the sRGB to ACES input and output matrices (glsl matrices are column major)
vec3 acesHill(vec3 color) {
    const mat3 inputMatrix = mat3(
        0.59719, 0.07600, 0.02840,
        0.35458, 0.90834, 0.13383,
        0.04823, 0.01566, 0.83777
    );
    const mat3 outputMatrix = mat3(
         1.60475, -0.10208, -0.00327,
        -0.53108,  1.10813, -0.07276,
        -0.07367, -0.00605,  1.07602
    );
    color = inputMatrix * color;
    vec3 a = color * (color + 0.0245786) - 0.000090537;
    vec3 b = color * (0.983729 * color + 0.4329510) + 0.238081;
    color = outputMatrix * (a / b);
    return clamp(color, 0.0, 1.0);
}

// John Hable's filmic curve from Uncharted 2
vec3 hableCurve(vec3 x) {
    const float A = 0.15, B = 0.50, C = 0.10, D = 0.20, E = 0.02, F = 0.30;
    return ((x * (A * x + C * B) + D * E) / (x * (A * x + B) + D * F)) - E / F;
}

vec3 uncharted2(vec3 x) {
    const float whitePoint = 11.2;
    return hableCurve(x * 2.0) / hableCurve(vec3(whitePoint));
}

// Benjamin Wrensch's minimal AgX approximation, base look, back to linear for the gamma below
vec3 agxContrast(vec3 x) {
    vec3 x2 = x * x;
    vec3 x4 = x2 * x2;
    return 15.5 * x4 * x2 - 40.14 * x4 * x + 31.96 * x4 - 6.868 * x2 * x + 0.4298 * x2 + 0.1191 * x - 0.00232;
}

vec3 agx(vec3 color) {
    const mat3 inset = mat3(
        0.842479062253094, 0.0423282422610123, 0.0423756549057051,
        0.0784335999999992, 0.878468636469772, 0.0784336,
        0.0792237451477643, 0.0791661274605434, 0.879142973793104
    );
    const mat3 outset = mat3(
        1.19687900512017, -0.0528968517574562, -0.0529716355144438,
        -0.0980208811401368, 1.15190312990417, -0.0980434501171241,
        -0.0990297440797205, -0.0989611768448433, 1.15107367264116
    );
    const float minEv = -12.47393;
    const float maxEv = 4.026069;

    color = inset * color;
    color = clamp(log2(max(color, vec3(1e-10))), minEv, maxEv);
    color = (color - minEv) / (maxEv - minEv);
    color = agxContrast(color);
    color = outset * color;
    return pow(max(color, vec3(0.0)), vec3(2.2));
}

// Khronos PBR Neutral, keeps base colors close to their authored values
vec3 khronosNeutral(vec3 color) {
    const float startCompression = 0.8 - 0.04;
    const float desaturation = 0.15;

    float x = min(color.r, min(color.g, color.b));
    float offset = x < 0.08 ? x - 6.25 * x * x : 0.04;
    color -= offset;

    float peak = max(color.r, max(color.g, color.b));
    if (peak < startCompression) {
        return color;
    }

    const float d = 1.0 - startCompression;
    float newPeak = 1.0 - d * d / (peak + d - startCompression);
    color *= newPeak / peak;

    float g = 1.0 - 1.0 / (desaturation * (peak - newPeak) + 1.0);
    return mix(color, vec3(newPeak), g);
}

vec3 tonemap(vec3 color) {
    switch (pc.tonemapper) {
        case 1: return reinhard(color);
        case 2: return acesNarkowicz(color);
        case 3: return acesHill(color);
        case 4: return uncharted2(color);
        case 5: return agx(color);
        case 6: return khronosNeutral(color);
        default: return clamp(color, 0.0, 1.0);
    }
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outImage);
    if (pixelCoord.x >= size.x || pixelCoord.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(size);
    vec3 color = max(texture(hdrImage, uv).rgb, vec3(0.0)) * pc.exposure;

    color = tonemap(color);
    color = pow(max(color, vec3(0.0)), vec3(pc.invGamma));

    imageStore(outImage, pixelCoord, vec4(color, 1.0));
}
