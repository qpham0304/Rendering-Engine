#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_gpu_shader_int64 : require

#include "common/ddgi.glsl"

// dispatched over the whole atlas, one invocation = one atlas texel (border texels included)
layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform UniformBufferObject {
    mat4 randomRotation;
    vec4 sunDirection;
    vec4 sunColor;
    float hysteresis;
    float maxRayDistance;
    float normalBias;
    uint clear;
    float skyIntensity;
} ubo;

layout(set = 0, binding = 1) uniform sampler2D rayColorBuffer;      // x: ray, y: probe
layout(set = 0, binding = 2) uniform sampler2D rayDistanceBuffer;   // x: ray, y: probe
layout(set = 0, binding = 3) uniform sampler2D lastFrameIrradianceAtlas;
layout(set = 0, binding = 4, rgba16f) writeonly uniform image2D currentFrameIrradianceAtlas;

layout(push_constant) uniform PushConstant {
    uint64_t objectsRef;
    uint64_t padding;
    vec4 gridOrigin;
    ivec4 probeCounts;      // xyz: probes per axis, w: total
    float gridSpacing;
    uint probesResolution;
} pc;

void main() {
    const int stride = DDGI_IRRADIANCE_RES + 2;
    ivec3 counts = pc.probeCounts.xyz;

    ivec2 atlasTexel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 atlasSize = ddgiAtlasSize(DDGI_IRRADIANCE_RES, counts);
    if (any(greaterThanEqual(atlasTexel, atlasSize))) {
        return;
    }

    ivec2 tile = atlasTexel / stride;
    int probeIdx = tile.x + tile.y * counts.x;
    vec3 texelDirection = ddgiTexelDirection(atlasTexel % stride, DDGI_IRRADIANCE_RES);

    vec3 sumRadiance = vec3(0.0);
    float sumWeight = 0.0;

    for (int r = 0; r < DDGI_RAYS_PER_PROBE; r++) {
        // back face hit, see ddgiProbeTrace.comp
        if (texelFetch(rayDistanceBuffer, ivec2(r, probeIdx), 0).r < 0.0) {
            continue;
        }

        // has to be the exact direction the trace pass used for this ray
        vec3 rayDir = normalize(mat3(ubo.randomRotation) * ddgiSphericalFibonacci(float(r), float(DDGI_RAYS_PER_PROBE)));
        float weight = max(0.0, dot(texelDirection, rayDir));

        sumRadiance += texelFetch(rayColorBuffer, ivec2(r, probeIdx), 0).rgb * weight;
        sumWeight += weight;
    }

    // border texels read their own history, it is the same value as the interior texel they duplicate
    vec3 result = texelFetch(lastFrameIrradianceAtlas, atlasTexel, 0).rgb;
    if (sumWeight > 0.0) {
        vec3 current = sumRadiance / sumWeight;
        result = (ubo.clear == 1) ? current : mix(current, result, ubo.hysteresis);
    }

    imageStore(currentFrameIrradianceAtlas, atlasTexel, vec4(result, 1.0));
}
