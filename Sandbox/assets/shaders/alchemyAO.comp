#version 450
layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0, r16f) uniform writeonly image2D outputRawAO;
layout (binding = 1, rgba16f) uniform readonly image2D inputPos;
layout (binding = 2, rgba16f) uniform readonly image2D inputNorm;

layout (push_constant) uniform Params {
    mat4 view;
    float radius;    // World space radius
    float bias;      // Small value like 0.01
    float intensity; // 1.0 to 2.0
    float projScale;
} n;

void main() {
    ivec2 uv = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inputPos);
    if (uv.x >= size.x || uv.y >= size.y) return;

    vec3 worldP = imageLoad(inputPos, uv).rgb;
    vec3 worldN = imageLoad(inputNorm, uv).rgb;

    // position is in world space so convert to view space or use depth map construction
    vec3 P = (n.view * vec4(worldP, 1.0)).xyz;
    vec3 N = mat3(n.view) * worldN;

    float sum = 0.0;
    const int SAMPLES = 16; 
    
    // McGuire's suggested constants
    const float epsilon = 0.0001; 
    const float radius2 = n.radius * n.radius;

    // Random rotation per pixel to hide banding
    float randomAngle = fract(sin(dot(vec2(uv), vec2(12.9898, 78.233))) * 43758.5453) * 6.283185;

    for (int i = 0; i < SAMPLES; i++) {
        float alpha = (float(i) + 0.5) / float(SAMPLES);        // Spiral Step
        float angle = alpha * (7.0 * 6.283185) + randomAngle;   // 7 revolutions
        
        // Screen-space offset scaled by projection and distance
        // n.projScale / P.z turns world-space radius into screen-space pixels
        float screenRadius = (n.projScale * n.radius) / -P.z;
        vec2 offset = vec2(cos(angle), sin(angle)) * (alpha * screenRadius);
        
        ivec2 sampleUV = uv + ivec2(offset);
        sampleUV = clamp(sampleUV, ivec2(0), size - 1);

        vec3 worldQ = imageLoad(inputPos, sampleUV).rgb;
        vec3 Q = (n.view * vec4(worldQ, 1.0)).xyz;

        // better estimator
        vec3 v = Q - P;
        float vv = dot(v, v);
        float vn = dot(v, N);

        // Falloff: (r^2 - v*v)^3
        float f = max(radius2 - vv, 0.0);
        // The estimator: f^3 * max(0, v*n - bias) / (v*v + epsilon)
        sum += (f * f * f) * max(0.0, vn - n.bias) / (vv + epsilon);
    }

    float sigma = 2.0;
    float k = 1.0;
    float ao = max(0.0, 1.0 - (2.0 * sigma / float(SAMPLES)) * sum);
    
    ao = pow(ao, n.intensity);

    imageStore(outputRawAO, uv, vec4(ao));
}