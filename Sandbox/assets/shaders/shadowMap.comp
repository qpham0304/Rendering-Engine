// /*
#version 450
layout(local_size_x = 128, local_size_y = 1) in;

layout(binding = 0, rgba32f) uniform readonly image2D src;
layout(binding = 1, rgba32f) uniform writeonly image2D dst;

layout(push_constant) uniform BlurControl {
    uint isVertical;
    uint radius;
    float sigma;
} ctrl;

// 128 threads + 100 extra pixels (2*w) = 228
shared vec4 v[256];

void main() {
    const int w = int(ctrl.radius);
    ivec2 bufferSize = imageSize(src);
    uint lpos = gl_LocalInvocationIndex;

    // reconstruct gpos based on direction
    ivec2 gpos;
    ivec2 dir;
    if (ctrl.isVertical == 0) {
        gpos = ivec2(int(gl_WorkGroupID.x * 128 + lpos), int(gl_WorkGroupID.y));
        dir = ivec2(1, 0);
    } else {
        gpos = ivec2(int(gl_WorkGroupID.x), int(gl_WorkGroupID.y * 128 + lpos));
        dir = ivec2(0, 1);
    }

    // every thread reads one pixel (gpos - w) this fills v[0] to v[127]
    ivec2 readPos1 = gpos - (dir * w);
    v[lpos] = imageLoad(src, clamp(readPos1, ivec2(0), bufferSize - 1));

    if (lpos < (2 * w)) { 
        ivec2 readPos2 = gpos + (dir * (128 - w));
        v[lpos + 128] = imageLoad(src, clamp(readPos2, ivec2(0), bufferSize - 1));
    }

    barrier();

    // the window for thread 'lpos' starts at v[lpos], ends at v[lpos + 100]
    vec4 sum = vec4(0.0);
    float totalWeight = 0.0;
    float s2 = 2.0 * ctrl.sigma * ctrl.sigma;
    float invS2 = 1.0 / s2;
    for(int j = 0; j <= 2 * w; j++) {
        float x = float(j - w);
        float weight = exp(-(x * x) * invS2);
        
        sum += v[lpos + j] * weight;
        totalWeight += weight;
    }
    
    if (gpos.x < bufferSize.x && gpos.y < bufferSize.y) {
        imageStore(dst, gpos, sum / totalWeight);
    }
}
// */

