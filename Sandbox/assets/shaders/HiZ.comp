#version 450

layout(local_size_x = 16, local_size_y = 16) in;

// mip 0: the scene depth, mips 1+: the previous (finer) hiz mip
layout(binding = 0) uniform sampler2D u_PreviousLevel;

// the current coarser mip level being written to
layout(binding = 1, r32f) uniform writeonly image2D u_CurrentLevel;

layout(push_constant) uniform PushConstants {
    vec2 u_PreviousLevelDimensions;
    int u_MipLevel;
} params;

// closest depth (standard z, 0 = near) so a ray in front of a cell's value can safely skip the whole cell
void main() {
    ivec2 currCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 currSize = imageSize(u_CurrentLevel);
    if (currCoord.x >= currSize.x || currCoord.y >= currSize.y) {
        return;
    }

    ivec2 prevSize = ivec2(params.u_PreviousLevelDimensions);

    if (params.u_MipLevel == 0) {
        // same size as the depth buffer, a straight copy
        imageStore(u_CurrentLevel, currCoord, vec4(texelFetch(u_PreviousLevel, currCoord, 0).r));
        return;
    }

    ivec2 prevCoord = currCoord * 2;
    float depth = texelFetch(u_PreviousLevel, prevCoord, 0).r;
    depth = min(depth, texelFetch(u_PreviousLevel, min(prevCoord + ivec2(1, 0), prevSize - 1), 0).r);
    depth = min(depth, texelFetch(u_PreviousLevel, min(prevCoord + ivec2(0, 1), prevSize - 1), 0).r);
    depth = min(depth, texelFetch(u_PreviousLevel, min(prevCoord + ivec2(1, 1), prevSize - 1), 0).r);

    // odd sized previous level: the last row / column also covers the texel the 2x2 footprint misses
    bool extraX = (prevSize.x & 1) != 0 && currCoord.x == currSize.x - 1;
    bool extraY = (prevSize.y & 1) != 0 && currCoord.y == currSize.y - 1;
    if (extraX) {
        depth = min(depth, texelFetch(u_PreviousLevel, prevCoord + ivec2(2, 0), 0).r);
        depth = min(depth, texelFetch(u_PreviousLevel, min(prevCoord + ivec2(2, 1), prevSize - 1), 0).r);
    }
    if (extraY) {
        depth = min(depth, texelFetch(u_PreviousLevel, prevCoord + ivec2(0, 2), 0).r);
        depth = min(depth, texelFetch(u_PreviousLevel, min(prevCoord + ivec2(1, 2), prevSize - 1), 0).r);
    }
    if (extraX && extraY) {
        depth = min(depth, texelFetch(u_PreviousLevel, prevCoord + ivec2(2, 2), 0).r);
    }

    imageStore(u_CurrentLevel, currCoord, vec4(depth));
}
