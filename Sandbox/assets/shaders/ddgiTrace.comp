#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_ray_query : require

// each workgroup handles one probe
// threads within the workgroup process the individual rays for that probe
// local_size_x RaysPerProbe count (e.g., 64, 128, or 256).
layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct Probe {
    vec4 position;
};

struct Material {
    uint albedoIdx;
    uint normalIdx;
    uint metalnessIdx;
    uint roughnessIdx;
    uint aoIdx;
    uint emissiveIdx;
    vec2 uvOffset;
    vec4 albedoFactor;
    vec4 normalFactor;
    float metallicFactor;
    float roughnessFactor;
    float aoFactor;
    float emissiveFactor;
};

const uint MAX_BONE_INFLUENCE = 4;
struct Vertex {
    vec3 pos;
    vec3 col;
    vec2 uv;
    vec3 normal;
    vec3 tangent;
    vec3 biTangent;
    int m_BoneIDs[MAX_BONE_INFLUENCE];
    float m_Weights[MAX_BONE_INFLUENCE];
};

struct Object {
    uint64_t vertexAddress;
    uint64_t indexAddress;
    uint64_t materialsRef;
    uint64_t materialIndiciesRef;
};

layout(buffer_reference, scalar) readonly buffer ObjectsBuffer { Object objects[]; };
layout(buffer_reference, scalar) readonly buffer Vertices      { Vertex v[]; };
layout(buffer_reference, scalar) readonly buffer Indices       { uint i[]; };
layout(buffer_reference, scalar) readonly buffer MaterialsBuffer{ Material m[]; };
layout(buffer_reference, scalar) readonly buffer MatIndicesBuffer { uint i[]; };
layout(buffer_reference, scalar) readonly buffer ProbesBuffer { Probe p[]; };

layout(set = 0, binding = 0) uniform UniformBufferObject {
    mat4 view;
    mat4 prevViewProj;
    mat4 proj;
    vec4 cameraPos;
    mat4 invView;
    mat4 invProj;
    float width;
    float height;
    float frameSeed;
    int frameCount;
    int clear;
} ubo;

layout(set = 0, binding = 1) uniform accelerationStructureEXT topLevelAS;

// TRANSIENT RAY BUFFERS (Output Destination for Pass 1)
// Size layout: Width = RaysPerProbe, Height = TotalProbes (Dim^3)
layout(set = 0, binding = 2, rgba16f) writeonly uniform image2D rayColorBuffer;
layout(set = 0, binding = 3, rg16f)   writeonly uniform image2D rayDistanceBuffer;
layout(set = 0, binding = 4) uniform sampler2D lastFrameIrradianceAtlas;
layout(set = 0, binding = 5) uniform sampler2D currentVisibilityAtlas;

layout(set = 1, binding = 0) uniform sampler2D samplerImages[];

layout(push_constant) uniform PushConstant {
    ObjectsBuffer objRef;
    ProbesBuffer probRef;
    vec4 gridOrigin;
    uint probesPerDimension;
    uint probesResolution; // The resolution of one probe tile (usually 8)
    float gridSpacing;
    vec4 lightDir;
} pc;

// DDGI Spherical Fibonacci Ray Generator
vec3 getFibonacciDirection(int sampleIdx, int numSamples, float frameSeed) {
    const float PI = 3.14159265359;
    const float GOLDEN_RATIO = 2.39996323; 

    float i = float(sampleIdx) + 0.5;
    float phi = acos(1.0 - 2.0 * i / float(numSamples));
    float theta = i * GOLDEN_RATIO + frameSeed; 

    return vec3(sin(phi) * cos(theta), sin(phi) * sin(theta), cos(phi));
}

// Octahedral 3D Vector to 2D UV coordinate converter
vec2 octEncode(vec3 v) {
    float l1norm = abs(v.x) + abs(v.y) + abs(v.z);
    vec2 res = v.xy * (1.0 / l1norm);
    if (v.z < 0.0) {
        res = (1.0 - abs(res.yx)) * vec2(res.x >= 0.0 ? 1.0 : -1.0, res.y >= 0.0 ? 1.0 : -1.0);
    }
    return res;
}

// Maps a Probe ID and a 3D Normal directly to absolute UV space inside the Irradiance Atlas
// Maps a Probe ID and a 3D Normal directly to absolute UV space inside an Atlas
vec2 getAtlasUV(int probeID, vec3 normal, int probesPerRow, vec2 atlasSize) {
    vec2 octUV = octEncode(normalize(normal)); 
    octUV = octUV * 0.5 + 0.5; // Map [-1, 1] to [0, 1]

    float resF = pc.probesResolution; // e.g., 8.0
    
    // Top-left corner of the 8x8 tile
    vec2 tileCorner = vec2(float(probeID % probesPerRow), float(probeID / probesPerRow)) * resF;

    // Shift past the 1-pixel border, map across the 6 inner texels, center on the texel half
    vec2 localPixelPos = 1.0 + octUV * (resF - 3.0) + 0.5; 
    
    
    vec2 pixelCoord = tileCorner + localPixelPos; 
    return pixelCoord / atlasSize;
}

// Trilinear Indirect Light Gathering with Chebyshev Visibility
vec3 sampleDDGIGrid(vec3 hitPos, vec3 hitNormal, sampler2D irradianceAtlas, sampler2D visibilityAtlas) {
    vec3 samplePos = hitPos + hitNormal * 0.2;  
    
    int dim = int(pc.probesPerDimension);
    vec3 gridCoord = (samplePos - pc.gridOrigin.xyz) / pc.gridSpacing;
    
    ivec3 baseProbeIdx = ivec3(floor(gridCoord));
    vec3 alpha = fract(gridCoord); 
    
    vec3 accumulatedIrradiance = vec3(0.0);
    float totalWeight = 0.0;
    
    vec2 atlasSize = vec2(textureSize(irradianceAtlas, 0));
    int probesPerRow = int(atlasSize.x) / int(pc.probesResolution); 

    for (int i = 0; i < 8; i++) {
        ivec3 offset = ivec3(i & 1, (i >> 1) & 1, (i >> 2) & 1);
        ivec3 pIdx = clamp(baseProbeIdx + offset, ivec3(0), ivec3(dim - 1));

        int probeID = pIdx.x + (pIdx.y * dim) + (pIdx.z * dim * dim);
        
        // Compute direction to this specific probe from the hit point
        vec3 probeWorldPos = pc.gridOrigin.xyz + (vec3(pIdx) * pc.gridSpacing);
        vec3 dirToProbe = probeWorldPos - hitPos;
        float distToProbe = length(dirToProbe);
        vec3 dirToProbeNorm = dirToProbe / max(distToProbe, 0.0001);

        vec2 colorAtlasUV = getAtlasUV(probeID, hitNormal, probesPerRow, atlasSize);
        vec3 probeColor = texture(irradianceAtlas, colorAtlasUV).rgb;

        vec2 atlasVisibilityUV = getAtlasUV(probeID, dirToProbeNorm, probesPerRow, atlasSize);
        vec2 distancePair = texture(visibilityAtlas, atlasVisibilityUV).rg;

        float mean = distancePair.x;
        float variance = abs(distancePair.y - (mean * mean));

        // Chebyshev Time-of-Flight visibility test
        float chebyshevWeight = 1.0;
        if (distToProbe > mean) {
            float minVariance = 0.001;
            // Add a small epsilon to variance to avoid division by zero
            chebyshevWeight = variance / (variance + pow(distToProbe - mean, 2.0));
            // Hard clamp/bias to smooth out noise
            chebyshevWeight = max(pow(chebyshevWeight, 3.0), 0.0);
        }

        // trilinear SPATIAL weight component
        float trilinearWeight = (offset.x == 1 ? alpha.x : 1.0 - alpha.x) *
                                (offset.y == 1 ? alpha.y : 1.0 - alpha.y) *
                                (offset.z == 1 ? alpha.z : 1.0 - alpha.z);

        // with all weights together
        float weight = trilinearWeight * max(0.0001, dot(dirToProbeNorm, hitNormal)) * chebyshevWeight;
        
        accumulatedIrradiance += probeColor * weight;
        totalWeight += weight;
    }
    
    return accumulatedIrradiance / max(totalWeight, 0.0001);
}

void main() {
    uint probeID = gl_WorkGroupID.x;      // Which spatial probe we are tracing for
    uint rayIdx = gl_LocalInvocationID.x; // Which individual ray direction this thread owns
    uint numRays = gl_WorkGroupSize.x;    // Total rays per probe (matching local size layout)

    vec3 rayOrigin = pc.probRef.p[probeID].position.xyz;
    vec3 rayDir = getFibonacciDirection(int(rayIdx), int(numRays), ubo.frameSeed);

    rayQueryEXT query;
    rayQueryInitializeEXT(query, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, rayOrigin, 0.001, rayDir, 1000.0);
    while(rayQueryProceedEXT(query));

    vec3 hitColor = vec3(0.0);
    float hitDist = 1000.0;

    if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        hitDist = rayQueryGetIntersectionTEXT(query, true);
        
        uint instanceID = rayQueryGetIntersectionInstanceCustomIndexEXT(query, true);
        uint primitiveID = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
        vec2 barycentrics = rayQueryGetIntersectionBarycentricsEXT(query, true);

        Object obj = pc.objRef.objects[instanceID];
        Vertices vertices = Vertices(obj.vertexAddress);
        Indices indices = Indices(obj.indexAddress);
        MaterialsBuffer materials = MaterialsBuffer(obj.materialsRef);
        MatIndicesBuffer matIndices = MatIndicesBuffer(obj.materialIndiciesRef);

        uint i0 = indices.i[3 * primitiveID + 0];
        uint i1 = indices.i[3 * primitiveID + 1];
        uint i2 = indices.i[3 * primitiveID + 2];

        Vertex v0 = vertices.v[i0];
        Vertex v1 = vertices.v[i1];
        Vertex v2 = vertices.v[i2];

        const vec3 bary = vec3(1.0 - barycentrics.x - barycentrics.y, barycentrics.x, barycentrics.y);
        vec2 texCoord = v0.uv * bary.x + v1.uv * bary.y + v2.uv * bary.z;
        vec3 hitNormal = normalize(v0.normal * bary.x + v1.normal * bary.y + v2.normal * bary.z);
        vec3 V = -rayDir;
        
        // mat4x3 objToWorld = rayQueryGetIntersectionObjectToWorldEXT(query, gl_RayQueryCommittedIntersectionEXT);
        mat4x3 objToWorld = rayQueryGetIntersectionObjectToWorldEXT(query, true);
        mat3 worldMat = mat3(objToWorld);
        mat3 normalMatrix = transpose(inverse(worldMat));   //TODO: consider performance
        hitNormal = normalize(normalMatrix * hitNormal);

        vec3 hitPos = rayOrigin + rayDir * hitDist;

        // Extract Material properties
        uint matIdx = matIndices.i[primitiveID];
        Material mat = materials.m[matIdx];
        vec3 albedo = texture(samplerImages[nonuniformEXT(mat.albedoIdx)], texCoord).rgb * mat.albedoFactor.rgb;
        vec3 emissiveColor = texture(samplerImages[nonuniformEXT(mat.emissiveIdx)], texCoord).rgb;
        vec3 emissive = emissiveColor * mat.emissiveFactor;

        // vec3 lightDir = normalize(vec3(0.5, 1.0, 0.2)); 
        vec3 lightDir = normalize(pc.lightDir.xyz);
        float shadow = 1.0;

        rayQueryEXT shadowQuery;
        rayQueryInitializeEXT(shadowQuery, topLevelAS, gl_RayFlagsTerminateOnFirstHitEXT, 0xFF, hitPos + hitNormal * 0.01, 0.001, lightDir, 1000.0);
        while(rayQueryProceedEXT(shadowQuery));
        if(rayQueryGetIntersectionTypeEXT(shadowQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
            shadow = 0.0;
        }

        float diffuse = max(dot(hitNormal, lightDir), 0.0);
        vec3 sunLight = vec3(1.0, 0.9, 0.8) * 10.0; 
        vec3 directLight = diffuse * shadow * sunLight;

        // infinite bounce accumulation
        // Sample the indirect light at this hit point from last frame's stable grid cache.
        // By adding this to directLight, we add an extra bounce of lighting calculations every single frame.
        vec3 indirectLight = sampleDDGIGrid(hitPos, hitNormal, lastFrameIrradianceAtlas, currentVisibilityAtlas);
        
        // Final outbound radiance back toward the sampling probe source
        hitColor = albedo * (directLight + indirectLight) + emissive;
    } else {
        hitColor = vec3(0.1, 0.3, 0.5); 
        hitDist = 1000.0;
    }

    // Write raw, unblended trace results straight into the structural 2D ray table array
    // X Coordinate = The Ray's Index inside the spiral
    // Y Coordinate = The 1D Identity of the Probe
    ivec2 rayTexel = ivec2(int(rayIdx), int(probeID));
    
    // Save both distance and distance-squared variants to feed Variance Distance tracking
    imageStore(rayColorBuffer, rayTexel, vec4(hitColor, 1.0));
    imageStore(rayDistanceBuffer, rayTexel, vec4(hitDist, hitDist * hitDist, 0.0, 0.0));
}