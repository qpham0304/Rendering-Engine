{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Sandbox (MSVC)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Sandbox/bin/windows-msvc/Debug/Sandbox.exe",
            "cwd": "${workspaceFolder}/Sandbox/bin/windows-msvc/Debug",
            "console": "integratedTerminal",
            "preLaunchTask": "build Sandbox Debug (msvc)"
        },
        {
            "name": "Release Sandbox (MSVC)",
