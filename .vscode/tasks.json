{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "build Sandbox Debug (ninja)",
            "command": "${workspaceFolder}/scripts/ninja-build.cmd",
            "args": ["window-ninja-debug"],
            "group": "build",
            "problemMatcher": "$msvc"
        },
        {
            "type": "shell",
            "label": "build Sandbox Release (ninja)",
            "command": "${workspaceFolder}/scripts/ninja-build.cmd",
            "args": ["window-ninja-release"],
            "group": "build",
            "problemMatcher": "$msvc"
        },
        {
            "type": "shell",
            "label": "build Sandbox Debug (msvc)",
            "command": "powershell",
            "args": [
                "-Command",
                "cmake --build --preset window-msvc-debug 2>&1 | Tee-Object -FilePath build.log; exit $LASTEXITCODE"
            ],
            "group": "build",
            "problemMatcher": "$msvc"
        },
        {
            "type": "cmake",
            "label": "build Sandbox Release (msvc)",
            "command": "build",
            "preset": "window-msvc-release",
            "group": "build",
            "problemMatcher": "$msvc"
        }
    ]
}